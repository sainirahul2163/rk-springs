---
/** Calculator page: intro, the tool island (default slot), then method notes and CTA. */
import type { FaqItem } from '@/components/ui/FAQ.astro';
import Callout from '@/components/ui/Callout.astro';
import CTASection from '@/components/ui/CTASection.astro';
import FAQ from '@/components/ui/FAQ.astro';
import type { RouteId } from '@/data/routes';
import PageLayout from './PageLayout.astro';

interface Props {
  route: RouteId;
  title: string;
  description: string;
  h1: string;
  lede?: string;
  context?: string;
  faqs?: readonly FaqItem[];
}

const { route, title, description, h1, lede, context, faqs } = Astro.props;
---

<PageLayout
  route={route}
  title={title}
  description={description}
  {...(context ? { context } : {})}
  {...(faqs ? { faqs } : {})}
  tool={{ name: h1, description }}
>
  <section class="container-page pt-6 pb-8">
    <p class="eyebrow mb-3 text-blue-700">Engineering tool</p>
    <h1 class="max-w-[46rem] text-h1">{h1}</h1>
    {lede && <p class="mt-4 max-w-[46rem] text-lead text-slate">{lede}</p>}
  </section>
  <section class="container-page pb-12" aria-label="Calculator">
    <slot />
  </section>
  <section class="container-page pb-16">
    <div class="prose max-w-[46rem]">
      <slot name="method" />
    </div>
    <Callout variant="warning" title="Estimates only" class="mt-8 max-w-[46rem]">
      Indicative engineering estimate. The final design is verified during development.
    </Callout>
    {faqs && faqs.length > 0 && (
      <div class="mt-12 max-w-[46rem]">
        <h2 class="text-h2 mb-6">Questions</h2>
        <FAQ items={faqs} />
      </div>
    )}
    <slot name="related" />
  </section>
  <CTASection context={context} />
</PageLayout>
