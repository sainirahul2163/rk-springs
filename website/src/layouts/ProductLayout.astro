---
/** Spring / wire-form product page chrome. Unique copy goes in the default and named slots. */
import Button from '@/components/ui/Button.astro';
import CTASection from '@/components/ui/CTASection.astro';
import FAQ from '@/components/ui/FAQ.astro';
import Icon from '@/components/ui/Icon.astro';
import PhotoPlaceholder from '@/components/ui/PhotoPlaceholder.astro';
import ProductDiagram from '@/components/diagrams/ProductDiagram.astro';
import RelatedLinks from '@/components/ui/RelatedLinks.astro';
import Section from '@/components/ui/Section.astro';
import SectionHeader from '@/components/ui/SectionHeader.astro';
import SpecTable from '@/components/ui/SpecTable.astro';
import Todo from '@/components/ui/Todo.astro';
import type { ProductPage } from '@/data/products';
import { getRoute } from '@/data/routes';
import { quoteHref, whatsappHref } from '@/lib/contact';
import PageLayout from './PageLayout.astro';

interface Props {
  product: ProductPage;
}

const { product: p } = Astro.props;
// Name the product in the section headings (keyword in an H2, varied wording, no stuffing).
const Noun = p.noun.charAt(0).toUpperCase() + p.noun.slice(1);
const a = /^[aeiou]/i.test(p.noun) ? 'an' : 'a';
---

<PageLayout
  route={p.route}
  title={p.title}
  description={p.description}
  context={p.context}
  faqs={p.faqs}
  product={{ name: getRoute(p.route).label, description: p.description }}
>
  <Section tone="grid" flush class="pt-6 pb-12">
    <div class="product-hero">
      <div>
        <p class="eyebrow mb-3 text-blue-700">Made to drawing or sample</p>
        <h1 class="text-h1">{p.h1}</h1>
        <p class="mt-4 max-w-[40rem] text-lead text-slate">{p.lede}</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <Button href={quoteHref(p.rfqQuery, p.context)} iconRight="arrow-right">
            Get a quote in 24 hours
          </Button>
          <Button
            href={whatsappHref(p.context)}
            variant="whatsapp"
            icon="message-circle"
            data-event="whatsapp_click"
            target="_blank"
            rel="noopener"
          >
            WhatsApp us
          </Button>
        </div>
      </div>
      <div class="product-visual">
        <div class="product-fig bp-grid">
          <ProductDiagram name={p.diagram} annotated />
        </div>
        <PhotoPlaceholder ratio="16 / 10" caption={p.photoCaption} class="mt-4" />
      </div>
    </div>
  </Section>

  <Section labelledby="spec-title">
    <SectionHeader
      id="spec-title"
      index={1}
      eyebrow="Specification"
      title={`${Noun} specification`}
    />
    <SpecTable rows={p.specs} class="mt-8" />
    <div class="mt-4">
      <Todo text="confirm end, hook or leg types actually formed, and any size limits." />
    </div>
  </Section>

  <Section tone="surface" labelledby="about-title">
    <SectionHeader
      id="about-title"
      index={2}
      eyebrow="Engineering"
      title={`What ${a} ${p.noun} is and how it works`}
    />
    <div class="prose mt-8 max-w-[46rem]">
      <slot name="about" />
    </div>
  </Section>

  <Section labelledby="types-title">
    <SectionHeader id="types-title" index={3} eyebrow="Variants" title={`Types of ${p.context}`} />
    <div class="mt-8">
      <slot name="types" />
    </div>
  </Section>

  <Section tone="tint" labelledby="materials-title">
    <SectionHeader
      id="materials-title"
      index={4}
      eyebrow="Materials"
      title={`${Noun} materials we use`}
      lede="Only the grades we actually buy. Tell us the environment and we will pick from this list."
    />
    <div class="mt-8">
      <slot name="materials" />
    </div>
  </Section>

  <Section labelledby="tips-title">
    <SectionHeader
      id="tips-title"
      index={5}
      eyebrow="Design"
      title={`What to put on ${a} ${p.noun} drawing`}
    />
    <div class="tips">
      <ol class="tips-list">
        {p.drawingNotes.map((item, i) => (
          <li>
            <span class="tips-n">{String(i + 1).padStart(2, '0')}</span>
            {item}
          </li>
        ))}
      </ol>
      <div class="prose">
        <slot name="tips" />
      </div>
    </div>
  </Section>

  <Section tone="surface" labelledby="apps-title">
    <SectionHeader id="apps-title" index={6} eyebrow="Use" title={`Where ${p.context} are used`} />
    <div class="prose mt-8 max-w-[46rem]">
      <slot name="applications" />
    </div>
    {p.usedIn && p.usedIn.length > 0 && (
      <RelatedLinks class="mt-8" title="Used in" links={p.usedIn} />
    )}
  </Section>

  <Section labelledby="make-title">
    <SectionHeader id="make-title" index={7} eyebrow="Process" title={`How we make ${p.context}`} />
    <p class="mt-8 max-w-[46rem] text-lead text-slate">{p.processNote}</p>
    {p.howWeMake && p.howWeMake.length > 0 && (
      <RelatedLinks class="mt-8" title="How we make it" links={p.howWeMake} />
    )}
  </Section>

  <Section tone="grid" labelledby="rfq-title">
    <SectionHeader
      id="rfq-title"
      index={8}
      eyebrow="Quote"
      title="Send this and we will quote in 24 hours"
    />
    <ul class="rfq-check mt-8">
      <li>
        <Icon name="check" size={18} /> Spring type and quantity
      </li>
      <li>
        <Icon name="check" size={18} /> Drawing, dimensioned photo, or the old spring
      </li>
      <li>
        <Icon name="check" size={18} /> Material, or where the part lives (dry, damp, outdoors)
      </li>
      <li>
        <Icon name="check" size={18} /> Any finish (plating is through partners)
      </li>
    </ul>
    <div class="mt-8 flex flex-wrap gap-3">
      <Button href={quoteHref(p.rfqQuery, p.context)} iconRight="arrow-right">
        Get a quote in 24 hours
      </Button>
      <Button
        href={whatsappHref(p.context)}
        variant="secondary"
        icon="message-circle"
        data-event="whatsapp_click"
        target="_blank"
        rel="noopener"
      >
        WhatsApp the details
      </Button>
    </div>
  </Section>

  <Section labelledby="faq-title">
    <SectionHeader id="faq-title" index={9} eyebrow="Questions" title={`${Noun} FAQ`} />
    <FAQ items={p.faqs} class="mt-8" />
  </Section>

  <Section tone="surface">
    <RelatedLinks title="Related" links={p.related} />
  </Section>

  <CTASection context={p.context} rfqQuery={p.rfqQuery} />
</PageLayout>

<style>
  .product-hero {
    display: grid;
    gap: 40px;
  }

  @media (min-width: 1024px) {
    .product-hero {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
      align-items: center;
      gap: 56px;
    }
  }

  .product-visual {
    content-visibility: auto;
    contain-intrinsic-size: 320px 280px;
  }

  .product-fig {
    padding: 16px 20px;
    border: 1px solid var(--color-grid);
    border-radius: var(--radius-card);
    color: var(--color-navy-900);
  }

  .tips {
    display: grid;
    gap: 40px;
    margin-top: 32px;
  }

  @media (min-width: 1024px) {
    .tips {
      grid-template-columns: 22rem minmax(0, 1fr);
      gap: 64px;
    }
  }

  .tips-list {
    display: grid;
    gap: 0;
    border-top: 1px solid var(--color-border);
  }

  .tips-list li {
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    gap: 12px;
    align-items: baseline;
    min-height: 44px;
    padding: 10px 0;
    border-bottom: 1px solid var(--color-border);
  }

  .tips-n {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--color-blue-700);
  }

  .rfq-check {
    display: grid;
    gap: 10px;
    max-width: 36rem;
  }

  .rfq-check li {
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: 32px;
  }

  .rfq-check :global(svg) {
    color: var(--color-success);
    flex: none;
  }
</style>
