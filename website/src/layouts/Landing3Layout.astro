---
/**
 * Standalone dark shell for the /landing3 design preview.
 *
 * This page deliberately sits outside the blue-and-white token system (AGENTS.md §6) at the
 * client's request: it is a separate concept for review, not part of the live site. Every colour
 * lives in the `.l3` scope below, so nothing here can leak into the production pages.
 */
import '@/styles/global.css';
import plexMono400 from '@fontsource/ibm-plex-mono/files/ibm-plex-mono-latin-400-normal.woff2?url';
import plexMono500 from '@fontsource/ibm-plex-mono/files/ibm-plex-mono-latin-500-normal.woff2?url';
import plexSans400 from '@fontsource/ibm-plex-sans/files/ibm-plex-sans-latin-400-normal.woff2?url';
import plexSans500 from '@fontsource/ibm-plex-sans/files/ibm-plex-sans-latin-500-normal.woff2?url';
import plexSans700 from '@fontsource/ibm-plex-sans/files/ibm-plex-sans-latin-700-normal.woff2?url';
import SEO, { type SEOProps } from '@/components/seo/SEO.astro';
import Header from '@/components/landing3/Header.astro';
import Footer from '@/components/landing3/Footer.astro';

const seo = Astro.props as SEOProps;

/**
 * global.css already self-hosts Plex Sans 400/600 and Plex Mono 400. This page also uses the
 * 500 and 700 cuts, which ship in the same installed packages, so no new dependency is added.
 */
const extraFonts = [
  { family: 'IBM Plex Sans', weight: 500, url: plexSans500 },
  { family: 'IBM Plex Sans', weight: 700, url: plexSans700 },
  { family: 'IBM Plex Mono', weight: 500, url: plexMono500 },
]
  .map(
    (f) =>
      `@font-face{font-family:'${f.family}';font-style:normal;font-display:swap;` +
      `font-weight:${f.weight};src:url(${f.url}) format('woff2')}`,
  )
  .join('');
---

<!doctype html>
<html lang="en-IN" class="l3-root">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <SEO {...seo} />
    <link rel="preload" href={plexSans400} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={plexSans700} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={plexMono400} as="font" type="font/woff2" crossorigin />
    <style is:inline set:html={extraFonts}></style>
    <link rel="icon" href="/brand/favicon-rk.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#08090b" />
    <meta name="format-detection" content="telephone=no" />
  </head>
  <body class="l3">
    <a class="l3-skip" href="#main">
      Skip to content
    </a>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />

    <style is:global>
      /* ---------------------------------------------------------------
       * /landing3 palette. Scoped to .l3 so the live site is untouched.
       * Graphite base, warm drawing-paper panels, amber annotation layer.
       * Every text pair below clears WCAG 2.2 AA (4.5:1).
       * ------------------------------------------------------------- */
      .l3 {
        --void: #08090b;
        --ink: #0d0f12;
        --panel: #14171c;
        --panel-2: #1b1f26;
        --line: #272c34;
        --line-2: #3a414d;

        --paper: #f2f1ed;
        --paper-2: #e6e4dd;
        --text: #f2f1ed;
        --text-2: #9aa3b0;
        --text-3: #808997;

        --amber: #ff8a3d;
        --amber-2: #e8690b;
        /* Amber dark enough to read as text on --paper (5.2:1). */
        --amber-ink: #a84300;

        /* Brand navy sampled from the client's logo. Unusable as text on graphite
         * (2.3:1), so it is reserved for the paper panels, and `--brand-lift` — the
         * same hue raised in lightness — carries the mark on dark (8.2:1). */
        --brand: #0a3262;
        --brand-lift: #7fa9de;
        --steel: #cfdcea;
        --wa: #25d366;

        --rail: 1px solid var(--line);
        --pad: 20px;
        --gutter: clamp(20px, 4vw, 56px);
        --maxw: 1320px;
        --sec: clamp(72px, 9vw, 136px);
        --hdr: 68px;

        background: var(--void);
        color: var(--text);
        font-family: var(--font-sans);
        -webkit-font-smoothing: antialiased;
      }

      /* The live site's mobile action bar is not rendered here. */
      html.l3-root {
        --mobile-bar-h: 0px;
        background: #08090b;
        scroll-padding-top: calc(var(--hdr) + 24px);
      }

      .l3 h1,
      .l3 h2,
      .l3 h3,
      .l3 h4 {
        color: var(--text);
        letter-spacing: -0.022em;
        text-wrap: balance;
      }

      .l3 :focus-visible {
        outline: 2px solid var(--amber);
        outline-offset: 3px;
        border-radius: 2px;
      }

      .l3 ::selection {
        background: var(--amber);
        color: var(--ink);
      }

      .l3 main:focus {
        outline: none;
      }

      .l3-skip {
        position: absolute;
        left: -9999px;
        z-index: 100;
      }

      .l3-skip:focus {
        display: inline-flex;
        align-items: center;
        min-height: 44px;
        left: 16px;
        top: 16px;
        padding: 0 18px;
        background: var(--amber);
        color: var(--ink);
        font-weight: 600;
        border-radius: 3px;
      }

      /* ---------------- shared primitives ---------------- */

      .l3-wrap {
        width: 100%;
        max-width: calc(var(--maxw) + 2 * var(--gutter));
        margin-inline: auto;
        padding-inline: var(--gutter);
      }

      .l3-sec {
        padding-block: var(--sec);
        position: relative;
      }

      /* Mono label used for every eyebrow, spec key and index number. */
      .l3-mono {
        font-family: var(--font-mono);
        font-size: 0.75rem;
        line-height: 1.4;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        font-weight: 500;
        font-variant-numeric: tabular-nums;
      }

      .l3-eyebrow {
        display: flex;
        align-items: center;
        gap: 12px;
        color: var(--amber);
      }

      .l3-eyebrow::before {
        content: '';
        width: 28px;
        height: 1px;
        background: currentColor;
        flex: none;
      }

      .l3-h2 {
        font-size: clamp(2rem, 1.35rem + 2.6vw, 3.35rem);
        line-height: 1.04;
        font-weight: 700;
        letter-spacing: -0.03em;
      }

      .l3-lede {
        color: var(--text-2);
        font-size: clamp(1.0625rem, 1rem + 0.25vw, 1.1875rem);
        line-height: 1.6;
        max-width: 58ch;
        text-wrap: pretty;
      }

      .l3-head {
        display: grid;
        gap: 20px;
        margin-bottom: clamp(40px, 5vw, 72px);
      }

      @media (min-width: 900px) {
        .l3-head.is-split {
          grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
          gap: 48px;
          align-items: end;
        }
      }

      .l3-head .l3-eyebrow {
        margin-bottom: 18px;
      }

      /* Hairline rule that spans the section. */
      .l3-rule {
        border: 0;
        border-top: var(--rail);
        margin: 0;
      }

      /* ---------------- buttons ---------------- */

      .l3-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        min-height: 52px;
        padding: 0 24px;
        border-radius: 3px;
        font-weight: 600;
        font-size: 1rem;
        line-height: 1.2;
        text-decoration: none;
        border: 1px solid transparent;
        transition:
          background-color 160ms var(--ease-out),
          border-color 160ms var(--ease-out),
          color 160ms var(--ease-out),
          transform 160ms var(--ease-out);
      }

      .l3-btn svg {
        flex: none;
      }

      .l3-btn-primary {
        background: var(--amber);
        color: #16120d;
      }

      .l3-btn-primary:hover {
        background: #ffa166;
        transform: translateY(-1px);
      }

      .l3-btn-ghost {
        border-color: var(--line-2);
        color: var(--text);
      }

      .l3-btn-ghost:hover {
        border-color: var(--text-2);
        background: var(--panel);
        transform: translateY(-1px);
      }

      .l3-btn-wa {
        border-color: color-mix(in srgb, var(--wa) 50%, transparent);
        color: var(--wa);
      }

      .l3-btn-wa:hover {
        background: color-mix(in srgb, var(--wa) 12%, transparent);
        border-color: var(--wa);
        transform: translateY(-1px);
      }

      .l3-btn-sm {
        min-height: 44px;
        padding: 0 16px;
        font-size: 0.9375rem;
      }

      /* Text link with an underline that thickens on hover. */
      .l3-link {
        color: var(--text);
        text-decoration: underline;
        text-decoration-color: var(--line-2);
        text-decoration-thickness: 1px;
        text-underline-offset: 0.25em;
        transition:
          text-decoration-color 160ms var(--ease-out),
          color 160ms var(--ease-out);
      }

      .l3-link:hover {
        color: var(--amber);
        text-decoration-color: var(--amber);
        text-decoration-thickness: 2px;
      }

      /* ---------------- drawing surface ---------------- */

      /* Re-tints the shared SVG drawing primitives for a dark sheet. */
      .l3-drawing {
        color: var(--steel);
        --dim-color: var(--amber);
        --dim-label-color: var(--amber);
        --dim-label-bg: transparent;
      }

      .l3-drawing.on-paper {
        color: #2b3139;
        --dim-color: var(--amber-ink);
        --dim-label-color: var(--amber-ink);
        --dim-label-bg: var(--paper);
      }

      /* 24 px engineering grid, used behind panels at low contrast. */
      .l3-grid-bg {
        background-image:
          linear-gradient(var(--line) 1px, transparent 1px),
          linear-gradient(90deg, var(--line) 1px, transparent 1px);
        background-size:
          24px 24px,
          24px 24px;
        background-position: center center;
      }

      /* ----- review-build helpers, re-tinted for the dark sheet -----
       * <Todo> and <PhotoPlaceholder> ship light-on-white for the live site. They render
       * only in dev and client-review builds — which is exactly what the client looks at —
       * so they are restyled here rather than left glaring on a black page.
       */
      .l3 .todo[data-todo] {
        background: color-mix(in srgb, var(--amber) 9%, var(--ink));
        border-color: color-mix(in srgb, var(--amber) 42%, transparent);
        color: var(--amber);
      }

      .l3 .photo-ph .photo-ph-box {
        background-color: var(--panel);
        background-image:
          linear-gradient(var(--line) 1px, transparent 1px),
          linear-gradient(90deg, var(--line) 1px, transparent 1px);
        background-size:
          24px 24px,
          24px 24px;
        border-color: var(--line-2);
        border-radius: 4px;
      }

      .l3 .photo-ph .photo-ph-inner {
        background: var(--panel-2);
        border: 1px solid var(--line-2);
        color: var(--text-3);
      }

      .l3 .photo-ph .photo-ph-cap {
        color: var(--text-3);
      }

      /* ---------------- scroll reveal (0 KB JS) ---------------- */

      /* Applied only where scroll-driven animations exist; elsewhere content is simply visible. */
      @supports (animation-timeline: view()) {
        @media (prefers-reduced-motion: no-preference) {
          .l3-reveal {
            animation: l3-rise linear both;
            animation-timeline: view();
            animation-range: entry 0% cover 22%;
          }
        }
      }

      @keyframes l3-rise {
        from {
          opacity: 0;
          transform: translateY(26px);
        }
        to {
          opacity: 1;
          transform: none;
        }
      }
    </style>
  </body>
</html>
