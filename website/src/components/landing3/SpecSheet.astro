---
/**
 * The capability data laid out as a real drawing sheet: zone markers down the frame,
 * an annotated part view, the spec column, and an ISO 7200-style title block.
 * Every value is read from site.ts, so it can never drift from CLIENT-PROFILE.md.
 */
import DoubleTorsionSpring from '@/components/diagrams/DoubleTorsionSpring.astro';
import Todo from '@/components/ui/Todo.astro';
import Logo from './Logo.astro';
import { site } from '@/data/site';

const specs: { k: string; v: string | readonly string[]; note?: string }[] = [
  { k: 'Wire diameter', v: site.capability.wireRangeLabel },
  { k: 'OD and free length', v: site.capability.sizeNote },
  { k: 'Wind', v: 'Left hand or right hand' },
  { k: 'Materials', v: site.capability.materials },
  { k: 'In-house', v: site.capability.inHouse },
  {
    k: 'Through partners',
    v: site.capability.viaPartners,
    note: 'Name the finish on the drawing; it comes back on your quote.',
  },
  { k: 'Minimum order', v: site.terms.moq, note: site.terms.moqNote },
  { k: 'Quotation', v: site.terms.quote },
  { k: 'Payment', v: site.terms.payment },
  { k: 'Delivery', v: site.terms.delivery },
  { k: 'Supply area', v: site.terms.supplyArea },
];

const titleBlock = [
  { k: 'Supplier', v: site.legalName, wide: true },
  { k: 'Unit', v: `${site.address.locality}, ${site.address.city} ${site.address.postalCode}` },
  { k: 'Units', v: 'mm · N · N/mm' },
  { k: 'Projection', v: 'First angle' },
  { k: 'Scale', v: 'NTS' },
  { k: 'GSTIN', v: site.gstin },
  { k: 'Udyam', v: site.udyam },
  { k: 'Sheet', v: '1 of 1' },
  { k: 'Rev', v: 'A' },
];

const zonesY = ['A', 'B', 'C', 'D'];
const zonesX = ['1', '2', '3', '4', '5', '6'];
---

<section class="sheet-sec l3-sec" aria-labelledby="sheet-title">
  <div class="l3-wrap">
    <header class="l3-head is-split l3-reveal">
      <div>
        <p class="l3-mono l3-eyebrow">02 — Capability</p>
        <h2 id="sheet-title" class="l3-h2">
          Read it like
          <br />a drawing.
        </h2>
      </div>
      <p class="l3-lede">
        Here is the whole envelope on one sheet — what we can coil, what we heat-treat and grind
        ourselves, what goes out to a plating partner, and the commercial terms. No asterisks.
      </p>
    </header>

    <div class="sheet l3-reveal">
      <!-- Drawing frame: zone letters and numbers around the border. -->
      <div class="sheet-zones is-top l3-mono" aria-hidden="true">
        {zonesX.map((z) => (
          <span>{z}</span>
        ))}
      </div>
      <div class="sheet-zones is-left l3-mono" aria-hidden="true">
        {zonesY.map((z) => (
          <span>{z}</span>
        ))}
      </div>
      <div class="sheet-zones is-right l3-mono" aria-hidden="true">
        {zonesY.map((z) => (
          <span>{z}</span>
        ))}
      </div>
      <div class="sheet-zones is-bottom l3-mono" aria-hidden="true">
        {zonesX.map((z) => (
          <span>{z}</span>
        ))}
      </div>

      <div class="sheet-body">
        <div class="sheet-view">
          <p class="l3-mono sheet-view-label">View A — double torsion spring</p>
          <DoubleTorsionSpring annotated decorative class="l3-drawing on-paper sheet-drawing" />
          <p class="sheet-view-note">
            Two opposite-wound coils joined by a centre loop. Our highest-volume part, together with
            the single torsion spring.
          </p>

          <div class="sheet-proj">
            <svg viewBox="0 0 96 34" aria-hidden="true" focusable="false">
              {/*
                First angle: the view taken from the left is drawn on the right. Looking at the
                frustum's small end gives two concentric circles, so trapezoid left, circles right.
              */}
              <path d="M4 11 34 2v30L4 23Z"></path>
              <circle cx="75" cy="17" r="15"></circle>
              <circle cx="75" cy="17" r="6"></circle>
              <path class="axis" d="M56 17h38M75 0v34"></path>
            </svg>
            <span class="l3-mono">First angle projection</span>
          </div>
        </div>

        <dl class="sheet-specs">
          {specs.map((row) => (
            <div class="sheet-row">
              <dt class="l3-mono">{row.k}</dt>
              <dd>
                {Array.isArray(row.v) ? (
                  <ul>
                    {row.v.map((item) => (
                      <li>{item}</li>
                    ))}
                  </ul>
                ) : (
                  row.v
                )}
                {row.note && <span class="sheet-note">{row.note}</span>}
              </dd>
            </div>
          ))}
        </dl>
      </div>

      <dl class="sheet-title-block">
        {titleBlock.map((cell) => (
          <div class:list={['tb-cell', cell.wide && 'is-wide']}>
            <dt class="l3-mono">{cell.k}</dt>
            <dd>
              {cell.wide && <Logo height={22} class="tb-logo" />}
              {cell.v}
            </dd>
          </div>
        ))}
      </dl>
    </div>

    <p class="sheet-foot l3-reveal">
      Anywhere inside this envelope, send it over — a drawing, a dimensioned photo, or the spring
      itself. You will have an answer and a price within 24 hours.
      <Todo text="add the machine list and name-plate photos when they arrive." />
    </p>
  </div>
</section>

<style>
  .sheet-sec {
    background: var(--ink);
    border-block: var(--rail);
  }

  /* --- the sheet --- */

  .sheet {
    position: relative;
    background: var(--paper);
    color: #1b2027;
    border-radius: 4px;
    padding: 22px;
    box-shadow:
      0 1px 0 color-mix(in srgb, #fff 55%, transparent) inset,
      0 32px 64px rgb(0 0 0 / 0.5);
  }

  .sheet-zones {
    position: absolute;
    display: flex;
    color: #8c8a82;
    font-size: 0.5625rem;
    letter-spacing: 0.1em;
  }

  .sheet-zones.is-top,
  .sheet-zones.is-bottom {
    left: 22px;
    right: 22px;
    justify-content: space-around;
  }

  .sheet-zones.is-top {
    top: 6px;
  }
  .sheet-zones.is-bottom {
    bottom: 6px;
  }

  .sheet-zones.is-left,
  .sheet-zones.is-right {
    top: 22px;
    bottom: 22px;
    flex-direction: column;
    justify-content: space-around;
  }

  .sheet-zones.is-left {
    left: 7px;
  }
  .sheet-zones.is-right {
    right: 7px;
  }

  .sheet-body {
    display: grid;
    border: 1px solid #c3c0b6;
  }

  /* --- part view --- */

  .sheet-view {
    display: flex;
    flex-direction: column;
    padding: clamp(18px, 3vw, 32px);
    background: linear-gradient(180deg, #fbfaf7, var(--paper));
  }

  .sheet-view-label {
    color: var(--amber-ink);
    font-size: 0.625rem;
    letter-spacing: 0.14em;
  }

  .sheet-view :global(.sheet-drawing) {
    width: 100%;
    max-width: 440px;
    margin: 20px auto 8px;
  }

  .sheet-view-note {
    max-width: 42ch;
    margin-top: 12px;
    color: #4e555e;
    font-size: 0.9375rem;
    line-height: 1.55;
    text-wrap: pretty;
  }

  .sheet-proj {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: auto;
    padding-top: 24px;
  }

  .sheet-proj svg {
    width: 104px;
    height: auto;
    flex: none;
    fill: none;
    stroke: #3a4049;
    stroke-width: 1.2;
    stroke-linejoin: round;
  }

  .sheet-proj .axis {
    stroke: #9a978e;
    stroke-width: 0.8;
    stroke-dasharray: 5 2 1 2;
  }

  .sheet-proj span {
    color: #6a7078;
    font-size: 0.625rem;
    letter-spacing: 0.12em;
  }

  /* --- spec column --- */

  .sheet-specs {
    border-top: 1px solid #c3c0b6;
    background: var(--paper);
  }

  .sheet-row {
    display: grid;
    gap: 2px;
    padding: 13px clamp(18px, 3vw, 28px);
    border-bottom: 1px solid #ddd9cf;
  }

  .sheet-row:last-child {
    border-bottom: 0;
  }

  .sheet-row:nth-child(even) {
    background: #eeece5;
  }

  .sheet-row dt {
    color: #6a7078;
    font-size: 0.625rem;
    letter-spacing: 0.13em;
  }

  .sheet-row dd {
    color: #1b2027;
    font-size: 0.9375rem;
    line-height: 1.5;
    font-weight: 500;
  }

  .sheet-row dd ul {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 2px 14px;
  }

  .sheet-row dd li {
    position: relative;
    padding-left: 13px;
  }

  .sheet-row dd li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 5px;
    height: 5px;
    background: var(--amber-ink);
  }

  .sheet-note {
    display: block;
    margin-top: 3px;
    color: #5c636b;
    font-size: 0.8125rem;
    font-weight: 400;
    line-height: 1.45;
  }

  /* --- title block --- */

  .sheet-title-block {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border: 1px solid #c3c0b6;
    border-top: 0;
    background: #e9e7df;
  }

  .tb-cell {
    padding: 10px 14px;
    border-right: 1px solid #c3c0b6;
    border-bottom: 1px solid #c3c0b6;
    min-width: 0;
  }

  .tb-cell dt {
    color: #71767e;
    font-size: 0.5625rem;
    letter-spacing: 0.14em;
  }

  .tb-cell dd {
    margin-top: 4px;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    color: #1b2027;
    overflow-wrap: anywhere;
  }

  .tb-cell.is-wide dd {
    display: grid;
    gap: 9px;
    justify-items: start;
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    font-weight: 600;
  }

  /* True brand navy reads at 11.3:1 on the paper panel. */
  .tb-cell :global(.tb-logo) {
    color: var(--brand);
  }

  .sheet-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 10px;
    margin-top: 26px;
    color: var(--text-2);
    font-size: 0.9375rem;
    line-height: 1.6;
    max-width: 70ch;
  }

  @media (min-width: 560px) {
    .sheet-title-block {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (min-width: 980px) {
    .sheet {
      padding: 26px;
    }

    .sheet-zones.is-top,
    .sheet-zones.is-bottom {
      left: 26px;
      right: 26px;
    }

    .sheet-zones.is-left,
    .sheet-zones.is-right {
      top: 26px;
      bottom: 26px;
    }

    .sheet-body {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.04fr);
    }

    .sheet-specs {
      border-top: 0;
      border-left: 1px solid #c3c0b6;
    }

    .sheet-title-block {
      grid-template-columns: 1.6fr repeat(4, minmax(0, 1fr));
      grid-auto-rows: 1fr;
    }

    .tb-cell.is-wide {
      grid-row: span 2;
      display: flex;
      flex-direction: column;
      justify-content: center;
    }
  }
</style>
