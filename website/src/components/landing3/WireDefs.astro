---
/**
 * Shared paint for the catalogue's spring renders.
 *
 * The technical drawings are plain stroked paths. Rather than redraw every spring, the stroke is
 * repainted with a vertical steel gradient (which gives the whole coil its cylindrical form) and
 * run through a specular-lighting filter that turns a flat stroke into a lit round wire. The result
 * is a rendered illustration, not a photograph, and nothing here claims to be one.
 *
 * Rendered once per page; the drawings reference these by id. Kept in the document (sized 0 rather
 * than display:none, which can stop filter references resolving).
 */
---

<svg class="wire-defs" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <!-- Front wire: bright at the top of the coil, falling to near-black at the bottom. -->
    <linearGradient id="rkw-steel" gradientUnits="userSpaceOnUse" x1="0" y1="6" x2="0" y2="144">
      <stop offset="0" stop-color="#f4f7fa"></stop>
      <stop offset="0.14" stop-color="#d2d9e0"></stop>
      <stop offset="0.34" stop-color="#9ba4ad"></stop>
      <stop offset="0.54" stop-color="#6a737d"></stop>
      <stop offset="0.74" stop-color="#414953"></stop>
      <stop offset="1" stop-color="#222932"></stop>
    </linearGradient>

    <!-- Far side of the coil: same light, pushed back. -->
    <linearGradient
      id="rkw-steel-back"
      gradientUnits="userSpaceOnUse"
      x1="0"
      y1="6"
      x2="0"
      y2="144"
    >
      <stop offset="0" stop-color="#949ba4"></stop>
      <stop offset="0.35" stop-color="#5c646d"></stop>
      <stop offset="0.7" stop-color="#353c45"></stop>
      <stop offset="1" stop-color="#1a2027"></stop>
    </linearGradient>

    <!--
      Flat stroke -> round wire. Blurring the alpha creates a ramp across the stroke width;
      specular lighting reads that ramp as a curved surface and lays a highlight along it.
    -->
    <filter
      id="rkw-3d"
      x="-12%"
      y="-12%"
      width="124%"
      height="124%"
      color-interpolation-filters="sRGB"
    >
      <feGaussianBlur in="SourceAlpha" stdDeviation="1.3" result="b"></feGaussianBlur>
      <feSpecularLighting
        in="b"
        surfaceScale="4.5"
        specularConstant="1.05"
        specularExponent="24"
        lighting-color="#ffffff"
        result="s"
      >
        <feDistantLight azimuth="238" elevation="62"></feDistantLight>
      </feSpecularLighting>
      <feComposite in="s" in2="SourceAlpha" operator="in" result="sc"></feComposite>
      <feComposite
        in="SourceGraphic"
        in2="sc"
        operator="arithmetic"
        k1="0"
        k2="1"
        k3="1"
        k4="0"
      ></feComposite>
    </filter>

    <!-- Softer pass for the far coils, so they do not out-sparkle the front. -->
    <filter
      id="rkw-3d-back"
      x="-12%"
      y="-12%"
      width="124%"
      height="124%"
      color-interpolation-filters="sRGB"
    >
      <feGaussianBlur in="SourceAlpha" stdDeviation="1.5" result="b"></feGaussianBlur>
      <feSpecularLighting
        in="b"
        surfaceScale="3"
        specularConstant="0.5"
        specularExponent="20"
        lighting-color="#cfe0f2"
        result="s"
      >
        <feDistantLight azimuth="238" elevation="62"></feDistantLight>
      </feSpecularLighting>
      <feComposite in="s" in2="SourceAlpha" operator="in" result="sc"></feComposite>
      <feComposite
        in="SourceGraphic"
        in2="sc"
        operator="arithmetic"
        k1="0"
        k2="1"
        k3="1"
        k4="0"
      ></feComposite>
    </filter>
  </defs>
</svg>

<style>
  .wire-defs {
    position: absolute;
    width: 0;
    height: 0;
    overflow: hidden;
    pointer-events: none;
  }
</style>
