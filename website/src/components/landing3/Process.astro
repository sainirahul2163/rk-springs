---
import { site } from '@/data/site';

const steps = [
  {
    t: 'Drawing or sample',
    d: 'A PDF, a dimensioned photo, or the old spring in an envelope. Tell us the quantity and where the part sits.',
  },
  {
    t: 'Quote in 24 hours',
    d: 'Price per piece, development charges if the run is under our usual minimum, and a lead time.',
  },
  {
    t: 'Development sample',
    d: 'For a new part we coil samples first, so you can fit them in the real assembly before anything is committed.',
  },
  {
    t: 'Your approval',
    d: 'Production does not start until you have tried the sample and said yes. If it needs a change, we change it.',
  },
  {
    t: 'Production',
    d: 'Coiling and forming, stress relieving in our own furnace, end grinding where the drawing calls for it.',
  },
  {
    t: 'Dispatch',
    d: site.terms.delivery + '. Payment immediate, or within 30 days.',
  },
];
---

<section class="proc l3-sec" aria-labelledby="proc-title">
  <div class="l3-wrap">
    <header class="l3-head is-split l3-reveal">
      <div>
        <p class="l3-mono l3-eyebrow">03 — How it runs</p>
        <h2 id="proc-title" class="l3-h2">
          Drawing on Monday.
          <br />
          Quote on Tuesday.
        </h2>
      </div>
      <p class="l3-lede">
        Six steps, and you hold a decision point at two of them. We take on about 8–10 new parts a
        month — small enough that the person who quotes you is the person who runs the job.
      </p>
    </header>

    <ol class="proc-rail l3-reveal">
      {steps.map((s, i) => (
        <li class="proc-step">
          <div class="proc-node" aria-hidden="true">
            <span class="proc-dot"></span>
          </div>
          <p class="l3-mono proc-num">Step {String(i + 1).padStart(2, '0')}</p>
          <h3 class="proc-t">{s.t}</h3>
          <p class="proc-d">{s.d}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .proc {
    background: var(--void);
  }

  .proc-rail {
    display: grid;
    gap: 0;
    list-style: none;
    counter-reset: step;
  }

  .proc-step {
    position: relative;
    padding: 0 0 34px 34px;
  }

  .proc-step:last-child {
    padding-bottom: 0;
  }

  /* The connecting line runs through the node column. */
  .proc-node {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 13px;
    display: flex;
    justify-content: center;
  }

  .proc-node::before {
    content: '';
    width: 1px;
    height: 100%;
    background: linear-gradient(var(--line-2), var(--line));
  }

  .proc-step:last-child .proc-node::before {
    background: linear-gradient(var(--line-2), transparent);
  }

  .proc-dot {
    position: absolute;
    top: 5px;
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: var(--void);
    border: 1px solid var(--amber);
  }

  .proc-dot::after {
    content: '';
    position: absolute;
    inset: 2.5px;
    border-radius: 50%;
    background: var(--amber);
  }

  .proc-num {
    color: var(--amber);
    font-size: 0.625rem;
    letter-spacing: 0.18em;
  }

  .proc-t {
    margin-top: 10px;
    font-size: 1.1875rem;
    font-weight: 600;
    letter-spacing: -0.015em;
  }

  .proc-d {
    margin-top: 8px;
    max-width: 46ch;
    color: var(--text-2);
    font-size: 0.9375rem;
    line-height: 1.6;
    text-wrap: pretty;
  }

  /* Wide screens: the rail turns horizontal and the line runs across the top. */
  @media (min-width: 900px) {
    .proc-rail {
      grid-template-columns: repeat(6, minmax(0, 1fr));
    }

    .proc-step {
      padding: 30px 20px 0 0;
    }

    .proc-step:last-child {
      padding-bottom: 0;
    }

    .proc-node {
      left: 0;
      right: 0;
      top: 0;
      bottom: auto;
      width: auto;
      height: 13px;
      justify-content: flex-start;
      align-items: center;
    }

    .proc-node::before {
      width: 100%;
      height: 1px;
      background: linear-gradient(90deg, var(--line-2), var(--line));
    }

    .proc-step:last-child .proc-node::before {
      background: linear-gradient(90deg, var(--line-2), transparent);
    }

    .proc-dot {
      top: 1px;
      left: 0;
    }

    .proc-d {
      font-size: 0.875rem;
    }
  }
</style>
