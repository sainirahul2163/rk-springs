---
/**
 * Per-page head tags: title, description, canonical, robots, Open Graph, JSON-LD.
 */
import type { FaqItem } from '@/components/ui/FAQ.astro';
import { site } from '@/data/site';
import type { RouteId } from '@/data/routes';
import { lastmodForPath } from '@/data/page-dates';
import { absoluteUrl, INDEXABLE } from '@/lib/env';
import type { GlossaryTermLd, JsonLdPage, PageKind, ServiceLd } from '@/lib/jsonld';
import { ogImagePath } from '@/lib/og';
import { formatTitle, seoWarnings } from '@/lib/seo';
import JsonLd from './JsonLd.astro';

export interface SEOProps {
  title: string;
  description: string;
  /** Use the title as-is, without the brand suffix. */
  absoluteTitle?: boolean;
  /** Path for the canonical URL. Defaults to the current path. */
  canonicalPath?: string;
  noindex?: boolean;
  ogType?: 'website' | 'article';
  route?: RouteId;
  pageKind?: PageKind;
  faqs?: readonly FaqItem[];
  product?: { name: string; description: string };
  service?: ServiceLd;
  glossary?: readonly GlossaryTermLd[];
  article?: JsonLdPage['article'];
  tool?: JsonLdPage['tool'];
}

const {
  title,
  description,
  absoluteTitle = false,
  canonicalPath,
  noindex = false,
  ogType = 'website',
  route,
  pageKind,
  faqs,
  product,
  service,
  glossary,
  article,
  tool,
} = Astro.props as SEOProps;

const fullTitle = formatTitle(title, absoluteTitle);
const path = canonicalPath ?? Astro.url.pathname;
const canonical = absoluteUrl(path);
const robots =
  noindex || !INDEXABLE ? 'noindex, nofollow' : 'index, follow, max-image-preview:large';
const ogImage = absoluteUrl(ogImagePath(path));
const ogAlt = `${absoluteTitle ? title : `${title}, ${site.brand}`}: technical line drawing on a blueprint grid`;
const googleVerification = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION;
const bingVerification = import.meta.env.PUBLIC_BING_SITE_VERIFICATION;

for (const w of seoWarnings(Astro.url.pathname, fullTitle, description)) console.warn(w);

const jsonldProps = {
  path,
  title: fullTitle,
  description,
  ...(route ? { route } : {}),
  ...(pageKind ? { kind: pageKind } : {}),
  ...(faqs && faqs.length > 0 ? { faqs } : {}),
  ...(product ? { product } : {}),
  ...(service ? { service } : {}),
  ...(glossary && glossary.length > 0 ? { glossary } : {}),
  ...(article ? { article } : {}),
  ...(tool ? { tool } : {}),
  image: ogImage,
  dateModified: article?.dateModified ?? lastmodForPath(path),
};
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<meta name="robots" content={robots} />

<meta property="og:type" content={ogType} />
<meta property="og:site_name" content={site.brand} />
<meta property="og:locale" content="en_IN" />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={ogAlt} />
{ogType === 'article' && article && (
  <>
    <meta property="article:published_time" content={article.datePublished} />
    <meta property="article:modified_time" content={article.dateModified} />
    <meta property="article:author" content={absoluteUrl('/about/')} />
  </>
)}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
<meta name="twitter:image:alt" content={ogAlt} />
{googleVerification && <meta name="google-site-verification" content={googleVerification} />}
{bingVerification && <meta name="msvalidate.01" content={bingVerification} />}

{!noindex && <JsonLd {...jsonldProps} />}
