---
import ContactLinks from '@/components/ui/ContactLinks.astro';
import HoursTable from '@/components/ui/HoursTable.astro';
import Icon from '@/components/ui/Icon.astro';
import Todo from '@/components/ui/Todo.astro';
import { mailHref, telHref } from '@/lib/contact';
import { linkTo } from '@/data/routes';
import { site } from '@/data/site';

const talawadeHref = linkTo('talawade');
---

<section id="factory" class="factory section-y" aria-labelledby="loc-title" data-surface="dark">
  <svg class="factory-wire" viewBox="0 0 720 500" fill="none" aria-hidden="true" focusable="false">
    {Array.from({ length: 8 }, (_, i) => (
      <path
        d={`M ${300 + i * 22} -40 C ${28 + i * 16} ${70 + i * 5}, ${100 + i * 18} ${330 + i * 4}, ${388 + i * 14} ${284 + i * 10} S ${824 + i * 10} ${58 + i * 8}, ${610 + i * 17} ${-92 + i * 6}`}
      />
    ))}
  </svg>
  <div class="container-page factory-inner">
    <header class="factory-header">
      <div>
        <p class="eyebrow factory-eyebrow">
          <span aria-hidden="true"></span>08 · Factory
        </p>
        <h2 id="loc-title">
          {site.address.locality},<br />
          {site.address.city}.
        </h2>
      </div>
      <div class="factory-intro">
        <p class="factory-region">
          <Icon name="map-pin" size={18} />
          {site.address.region}, {site.address.country}
        </p>
        <p>{site.areaContext}.</p>
      </div>
    </header>

    <div class="factory-grid">
      <div class="factory-address" data-surface="light">
        <div class="factory-panel-label">
          <span class="factory-icon">
            <Icon name="map-pin" size={20} />
          </span>
          <p class="eyebrow">Address &amp; contact</p>
        </div>
        <address class="factory-company">
          <p class="factory-brand">{site.brand}</p>
          <p class="factory-brand-line">{site.brandLine}</p>
          <p class="factory-street">
            {site.address.street},<br />
            {site.address.locality}, {site.address.city},<br />
            {site.address.region} {site.address.postalCode}, {site.address.country}
          </p>
          <dl class="factory-contact-details">
            <div>
              <dt>Phone</dt>
              <dd>
                {site.phones.map((phone) => (
                  <a href={telHref(phone.e164)} data-event="call_click">
                    {phone.display}
                  </a>
                ))}
                <Todo text="confirm the main number." />
              </dd>
            </div>
            <div>
              <dt>Email</dt>
              <dd>
                {site.emails.map((email) => (
                  <a href={mailHref(email)} data-event="email_click">
                    {email}
                  </a>
                ))}
                <Todo text="pick the main email." />
              </dd>
            </div>
          </dl>
        </address>
        <dl class="factory-tax">
          <div>
            <dt>GSTIN</dt>
            <dd>{site.gstin}</dd>
          </div>
          <div>
            <dt>Udyam</dt>
            <dd>{site.udyam}</dd>
          </div>
        </dl>
        <ContactLinks class="factory-contact" />
      </div>

      <div class="factory-hours-panel">
        <div class="factory-hours-heading">
          <span class="factory-icon">
            <Icon name="clock" size={20} />
          </span>
          <h3>Working hours</h3>
        </div>
        <p class="factory-closed">
          {site.hours.closedDays.map((day) => (
            <span>{day} closed</span>
          ))}
        </p>
        <HoursTable class="factory-hours" />
        <div class="factory-dispatch">
          <Icon name="truck" size={22} />
          <div>
            <p class="eyebrow">Dispatch</p>
            <p>{site.terms.delivery}</p>
          </div>
        </div>
        {talawadeHref && (
          <a class="factory-location-link" href={talawadeHref}>
            <span>
              <strong>Explore Talawade &amp; PCMC</strong>
              <span>Address, hours and nearby industrial areas</span>
            </span>
            <Icon name="arrow-up-right" size={22} />
          </a>
        )}
      </div>
    </div>
  </div>
</section>

<style>
  .factory {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    color: var(--color-white);
    background:
      radial-gradient(
        ellipse at 95% 0%,
        color-mix(in srgb, var(--color-blue-700) 55%, transparent),
        transparent 55%
      ),
      linear-gradient(125deg, var(--color-navy-950), var(--color-navy-900));
    border-bottom: 1px solid color-mix(in srgb, var(--color-blue-300) 24%, transparent);
  }

  .factory-wire {
    position: absolute;
    z-index: -1;
    top: -56px;
    right: -160px;
    width: min(72vw, 880px);
    height: auto;
    pointer-events: none;
    stroke: var(--color-blue-300);
    stroke-width: 1;
    opacity: 0.15;
    mask-image: linear-gradient(var(--color-white), transparent 95%);
  }

  .factory-header {
    display: grid;
    gap: 24px;
    margin-bottom: 40px;
  }

  .factory-eyebrow {
    display: flex;
    align-items: center;
    gap: 12px;
    color: var(--color-blue-300);
    margin-bottom: 20px;
  }

  .factory-eyebrow > span {
    width: 32px;
    height: 1px;
    background: var(--color-blue-400);
  }

  .factory-header h2 {
    color: var(--color-white);
    font-size: clamp(2.5rem, 2rem + 2.4vw, 4.25rem);
    line-height: 1.03;
    letter-spacing: -0.025em;
    text-wrap: initial;
  }

  .factory-intro {
    max-width: 40ch;
    align-self: end;
    color: var(--color-blue-100);
    line-height: 1.65;
  }

  .factory-region {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--color-blue-300);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    margin-bottom: 12px;
  }

  .factory-grid {
    display: grid;
    gap: 24px;
  }

  .factory-address,
  .factory-hours-panel {
    min-width: 0;
    padding: clamp(20px, 3vw, 36px);
    border-radius: var(--radius-card);
  }

  .factory-address {
    color: var(--color-ink);
    background: var(--color-white);
    border-top: 3px solid var(--color-blue-400);
  }

  .factory-panel-label,
  .factory-hours-heading {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 24px;
  }

  .factory-panel-label {
    color: var(--color-blue-700);
  }

  .factory-icon {
    display: grid;
    place-items: center;
    flex: 0 0 44px;
    height: 44px;
    border: 1px solid var(--color-grid);
    border-radius: var(--radius-control);
  }

  .factory-company {
    font-style: normal;
    min-width: 0;
  }

  .factory-brand {
    color: var(--color-navy-900);
    font-weight: 600;
    font-size: 1.375rem;
    line-height: 1.35;
  }

  .factory-brand-line {
    margin-top: 4px;
    color: var(--color-slate);
    font-size: var(--text-small);
  }

  .factory-street {
    margin-top: 20px;
    line-height: 1.6;
  }

  .factory-contact-details,
  .factory-tax {
    display: grid;
    gap: 20px;
    margin-top: 24px;
    padding-top: 20px;
    border-top: 1px solid var(--color-border);
  }

  .factory-contact-details > div,
  .factory-tax > div {
    min-width: 0;
  }

  .factory-address dt {
    font-family: var(--font-mono);
    color: var(--color-slate);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 6px;
  }

  .factory-contact-details a {
    display: flex;
    align-items: center;
    min-height: 44px;
    max-width: 100%;
    overflow-wrap: anywhere;
    color: var(--color-blue-700);
    text-decoration: underline;
    text-underline-offset: 0.22em;
    font-size: 0.9375rem;
  }

  .factory-contact-details a:hover {
    color: var(--color-action-700);
  }

  .factory-contact-details :global(.todo) {
    margin-top: 8px;
  }

  .factory-tax {
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
    gap: 12px;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    overflow-wrap: anywhere;
  }

  .factory-address :global(:focus-visible) {
    outline-color: var(--color-action-600);
  }

  .factory-address :global(.factory-contact) {
    margin-top: 24px;
    padding-top: 24px;
    border-top: 1px solid var(--color-border);
  }

  .factory-hours-panel {
    display: flex;
    flex-direction: column;
    background: color-mix(in srgb, var(--color-blue-800) 32%, var(--color-navy-900));
    border: 1px solid color-mix(in srgb, var(--color-blue-300) 28%, transparent);
  }

  .factory-hours-heading {
    margin-bottom: 16px;
  }

  .factory-hours-heading .factory-icon {
    color: var(--color-blue-300);
    border-color: color-mix(in srgb, var(--color-blue-300) 36%, transparent);
  }

  .factory-hours-heading h3 {
    color: var(--color-white);
    font-size: 1.375rem;
  }

  .factory-closed {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 24px;
  }

  .factory-closed span {
    padding: 5px 10px;
    border: 1px solid color-mix(in srgb, var(--color-blue-300) 45%, transparent);
    border-radius: var(--radius-control);
    color: var(--color-blue-100);
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }

  .factory-hours-panel :global(.hours th),
  .factory-hours-panel :global(.hours td) {
    padding-block: 14px;
    color: var(--color-blue-100);
  }

  .factory-hours-panel :global(.hours tr + tr) {
    border-color: color-mix(in srgb, var(--color-blue-300) 22%, transparent);
  }

  .factory-hours-panel :global(.hours .is-closed th),
  .factory-hours-panel :global(.hours .is-closed td) {
    color: var(--color-white);
  }

  .factory-hours-panel :global(.hours .is-closed td::before) {
    color: var(--color-blue-300);
  }

  .factory-dispatch {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    margin-top: auto;
    padding-top: 32px;
    color: var(--color-blue-100);
    font-size: 0.9375rem;
  }

  .factory-dispatch > :global(svg) {
    flex: 0 0 auto;
    margin-top: 2px;
    color: var(--color-blue-300);
  }

  .factory-dispatch .eyebrow {
    margin-bottom: 6px;
    color: var(--color-blue-300);
    font-size: 0.6875rem;
  }

  .factory-location-link {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    min-height: 64px;
    margin-top: 24px;
    padding-block: 20px 0;
    border-top: 1px solid color-mix(in srgb, var(--color-blue-300) 28%, transparent);
    color: var(--color-white);
    text-decoration: none;
  }

  .factory-location-link strong {
    display: block;
    font-weight: 500;
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }

  .factory-location-link > span > span {
    display: block;
    margin-top: 6px;
    color: var(--color-blue-300);
    font-size: 0.8125rem;
  }

  .factory-location-link > :global(svg) {
    flex: 0 0 auto;
    color: var(--color-blue-300);
  }

  .factory-location-link:hover {
    color: var(--color-blue-300);
  }

  @media (min-width: 900px) {
    .factory-header,
    .factory-grid {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    }

    .factory-header {
      gap: 64px;
      margin-bottom: 48px;
    }
  }

  @media (min-width: 600px) {
    .factory-contact-details {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.3fr);
      gap: 20px;
    }
  }

  @media (max-width: 599.98px) {
    .factory-address :global(.factory-contact > .btn) {
      width: 100%;
    }

    .factory-hours-panel :global(.hours) {
      font-size: 0.8125rem;
    }

    .factory-wire {
      width: 150vw;
      right: -70vw;
      opacity: 0.12;
    }
  }

  @media (max-width: 359.98px) {
    .factory-tax {
      grid-template-columns: 1fr;
    }
  }
</style>
