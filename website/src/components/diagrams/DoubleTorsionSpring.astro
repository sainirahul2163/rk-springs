---
import Drawing from './Drawing.astro';
import DimensionLine from './DimensionLine.astro';
import Leader from './Leader.astro';
import { fmt, helix } from './geometry';

interface Props {
  annotated?: boolean;
  decorative?: boolean;
  class?: string;
}

const { annotated = false, decorative = false, class: cls } = Astro.props;

const yc = 66;
const R = 21;
const tilt = 0.32;
const turns = 4.5;
const pitch = 5.2;
// Left body winds left-to-right, right body is its mirror (opposite hand).
const L = helix({ x0: 52, yc, turns, pitch, radius: R, tilt, dir: 1 });
const Rt = helix({ x0: 188, yc, turns, pitch, radius: R, tilt, dir: -1 });

const loopY = yc + R + 40;
const rr = 8;
const loop =
  `M${fmt(L.end.x)} ${fmt(L.end.y)}L${fmt(L.end.x)} ${fmt(loopY - rr)}` +
  `Q${fmt(L.end.x)} ${fmt(loopY)} ${fmt(L.end.x + rr)} ${fmt(loopY)}` +
  `L${fmt(Rt.end.x - rr)} ${fmt(loopY)}` +
  `Q${fmt(Rt.end.x)} ${fmt(loopY)} ${fmt(Rt.end.x)} ${fmt(loopY - rr)}` +
  `L${fmt(Rt.end.x)} ${fmt(Rt.end.y)}`;

const legs =
  `M${fmt(L.start.x)} ${fmt(L.start.y)}L${fmt(L.start.x - 34)} ${fmt(L.start.y - 30)}` +
  `M${fmt(Rt.start.x)} ${fmt(Rt.start.y)}L${fmt(Rt.start.x + 34)} ${fmt(Rt.start.y - 30)}`;
---

<Drawing
  viewBox="0 0 240 150"
  title="Double torsion spring: two opposite-wound coils joined by a U-shaped centre loop"
  decorative={decorative}
  class={cls}
>
  <path class="w w-back" d={L.back + Rt.back}></path>
  <path class="w" d={L.front + Rt.front}></path>
  <path class="w" d={loop + legs}></path>
  {annotated && (
    <>
      <DimensionLine
        x1={L.end.x}
        y1={loopY + 16}
        x2={Rt.end.x}
        y2={loopY + 16}
        label="CENTRE LOOP"
        extend={-12}
      />
      <Leader
        x={L.start.x + 8}
        y={yc + R}
        ex={L.start.x - 8}
        ey={yc + R + 22}
        label="LH"
        align="left"
      />
      <Leader x={Rt.start.x - 8} y={yc + R} ex={Rt.start.x + 8} ey={yc + R + 22} label="RH" />
    </>
  )}
</Drawing>
