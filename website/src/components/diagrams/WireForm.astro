---
import Drawing from './Drawing.astro';
import DimensionLine from './DimensionLine.astro';
import Leader from './Leader.astro';

interface Props {
  annotated?: boolean;
  decorative?: boolean;
  class?: string;
}

const { annotated = false, decorative = false, class: cls } = Astro.props;

// R-clip (hairpin cotter): straight leg, return bend, outer leg with a locking hump.
const rclip =
  'M30 52L194 52A22 22 0 0 1 194 96L156 96C136 96 132 70 112 70C92 70 88 98 66 100L34 104' +
  'M30 52L26 49';
// Small S-hook alongside.
const shook = 'M210 108A9 9 0 1 0 210 126L210 130A9 9 0 1 1 210 148';
---

<Drawing
  viewBox="0 0 240 150"
  title="Wire forms: an R-clip and an S-hook bent from spring wire"
  decorative={decorative}
  class={cls}
>
  <path class="w" d={rclip}></path>
  <path class="w" d={shook} transform="translate(-14 -20)"></path>
  {annotated && (
    <>
      <DimensionLine x1={30} y1={30} x2={216} y2={30} label="LENGTH" extend={14} />
      <Leader x={214} y={74} ex={226} ey={88} label="R" />
      <Leader x={112} y={70} ex={96} ey={124} label="HUMP" align="left" />
    </>
  )}
</Drawing>
