---
import Drawing from './Drawing.astro';
import DimensionLine from './DimensionLine.astro';
import { fmt, helix } from './geometry';

interface Props {
  annotated?: boolean;
  decorative?: boolean;
  class?: string;
}

const { annotated = false, decorative = false, class: cls } = Astro.props;

const yc = 72;
const turns = 7;
const R0 = 44;
const R1 = 14;
const x0 = 50;
const tilt = 0.3;
const radius = (u: number) => R0 + (R1 - R0) * (u / turns);
const h = helix({ x0, yc, turns, pitch: 20, radius, tilt });
const left = x0 - tilt * R0;
const right = x0 + h.length + tilt * R1;
---

<Drawing
  viewBox="0 0 240 150"
  title="Conical compression spring with coils tapering from a large to a small diameter"
  decorative={decorative}
  class={cls}
>
  <path class="c" d={`M${fmt(left - 12)} ${yc}L${fmt(right + 12)} ${yc}`}></path>
  <path class="w w-back" d={h.back}></path>
  <path class="w" d={h.front}></path>
  {annotated && (
    <>
      <DimensionLine x1={left - 12} y1={yc - R0} x2={left - 12} y2={yc + R0} label="LARGE OD" />
      <DimensionLine x1={right + 14} y1={yc - R1} x2={right + 14} y2={yc + R1} label="SMALL OD" />
      <DimensionLine
        x1={left}
        y1={yc + R0 + 18}
        x2={right}
        y2={yc + R0 + 18}
        label="FREE LENGTH"
        ends="tick"
      />
    </>
  )}
</Drawing>
