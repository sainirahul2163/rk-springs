---
/** Datasheet-style table: slate label column, mono values, zebra rows. */
export interface SpecRow {
  label: string;
  value: string | readonly string[];
  note?: string;
}

interface Props {
  rows: readonly SpecRow[];
  caption?: string;
  class?: string;
}

const { rows, caption, class: className } = Astro.props;
---

<div class:list={['spec-wrap', className]}>
  <table class="spec">
    {caption && <caption class="eyebrow">{caption}</caption>}
    <tbody>
      {rows.map((r) => (
        <tr>
          <th scope="row">{r.label}</th>
          <td>
            {Array.isArray(r.value) ? (
              <ul>
                {r.value.map((v) => (
                  <li>{v}</li>
                ))}
              </ul>
            ) : (
              r.value
            )}
            {r.note && <span class="spec-note">{r.note}</span>}
          </td>
        </tr>
      ))}
    </tbody>
  </table>
</div>

<style>
  .spec-wrap {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    overflow: hidden;
    background: var(--color-white);
  }

  .spec {
    width: 100%;
    border-collapse: collapse;
    font-variant-numeric: tabular-nums;
  }

  caption {
    text-align: left;
    padding: 12px 16px;
    color: var(--color-slate);
    border-bottom: 1px solid var(--color-border-strong);
    background: var(--color-white);
  }

  tr:nth-child(even) {
    background: var(--color-blue-50);
  }

  tr + tr {
    border-top: 1px solid var(--color-border);
  }

  th {
    width: 38%;
    text-align: left;
    vertical-align: top;
    font-weight: 400;
    font-size: 0.9375rem;
    color: var(--color-slate);
    padding: 12px 16px;
  }

  td {
    font-family: var(--font-mono);
    font-size: 0.9375rem;
    color: var(--color-navy-900);
    padding: 12px 16px;
    vertical-align: top;
  }

  td ul {
    display: grid;
    gap: 2px;
  }

  .spec-note {
    display: block;
    margin-top: 4px;
    font-family: var(--font-sans);
    font-size: var(--text-small);
    color: var(--color-slate);
  }

  @media (max-width: 479.98px) {
    tr {
      display: grid;
    }
    th {
      width: auto;
      padding-bottom: 0;
      font-size: var(--text-small);
    }
    td {
      padding-top: 4px;
    }
  }
</style>
