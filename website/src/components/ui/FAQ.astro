---
/** Accordion built on native <details>; zero JS. Answers are trusted HTML from our own data files. */
export interface FaqItem {
  q: string;
  a: string;
}

interface Props {
  items: readonly FaqItem[];
  class?: string;
}

const { items, class: className } = Astro.props;
---

<div class:list={['faq', className]}>
  {items.map((it) => (
    <details class="faq-item">
      <summary class="faq-q">
        <span>{it.q}</span>
        <span class="faq-icon" aria-hidden="true" />
      </summary>
      <div class="faq-a prose" set:html={it.a} />
    </details>
  ))}
</div>

<style>
  .faq {
    border-top: 1px solid var(--color-border);
  }

  .faq-item {
    border-bottom: 1px solid var(--color-border);
  }

  .faq-q {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: 56px;
    padding: 14px 4px;
    cursor: pointer;
    list-style: none;
    font-weight: 500;
    font-size: 1.0625rem;
    color: var(--color-navy-900);
    transition: color 150ms var(--ease-out);
  }

  .faq-q::-webkit-details-marker {
    display: none;
  }

  .faq-q:hover {
    color: var(--color-action-700);
  }

  .faq-icon {
    position: relative;
    flex: none;
    width: 20px;
    height: 20px;
    border: 1px solid var(--color-border-strong);
    border-radius: 3px;
  }

  .faq-icon::before,
  .faq-icon::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    width: 10px;
    height: 1.5px;
    background: currentColor;
    transform: translate(-50%, -50%);
    transition: transform 200ms var(--ease-out);
  }

  .faq-icon::after {
    transform: translate(-50%, -50%) rotate(90deg);
  }

  details[open] .faq-icon::after {
    transform: translate(-50%, -50%) rotate(0deg);
  }

  .faq-a {
    padding: 0 4px 20px;
    color: var(--color-ink);
  }
</style>
