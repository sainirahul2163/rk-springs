---
/** Mono index eyebrow (e.g. "01 · PRODUCTS") with the sheet's amber rule, heading, lede. */
interface Props {
  title: string;
  eyebrow?: string;
  index?: number;
  lede?: string;
  id?: string;
  as?: 'h1' | 'h2' | 'h3';
  align?: 'left' | 'center';
  class?: string;
}

const {
  title,
  eyebrow,
  index,
  lede,
  id,
  as: Tag = 'h2',
  align = 'left',
  class: className,
} = Astro.props;
const label = [index !== undefined ? String(index).padStart(2, '0') : null, eyebrow]
  .filter(Boolean)
  .join(' · ');
const sizes = { h1: 'text-h1', h2: 'text-h2', h3: 'text-h3' } as const;
---

<header class:list={['max-w-[46rem]', align === 'center' && 'mx-auto text-center', className]}>
  {label && (
    <p
      class:list={[
        'eyebrow mb-3 flex items-center gap-3',
        'text-amber',
        align === 'center' && 'justify-center',
      ]}
    >
      <span aria-hidden="true" class="h-px w-8 bg-amber" />
      {label}
    </p>
  )}
  <Tag id={id} class:list={[sizes[Tag]]}>
    {title}
  </Tag>
  {lede && <p class="mt-4 text-lead text-text-2">{lede}</p>}
</header>
