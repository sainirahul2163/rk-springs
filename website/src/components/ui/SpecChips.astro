---
interface Props {
  chips: readonly string[];
  class?: string;
}

const { chips, class: className } = Astro.props;
---

<ul class:list={['flex flex-wrap gap-1.5', className]} aria-label="Key specifications">
  {chips.map((c) => (
    <li class="rounded-[3px] border border-grid bg-blue-50 px-2 py-0.5 font-mono text-[0.78rem] leading-5 text-navy-900 tabular">
      {c}
    </li>
  ))}
</ul>
