---
import { primaryPhone, site } from '@/data/site';
import { quoteHref, telHref, whatsappHref } from '@/lib/contact';
import Button from './Button.astro';
import Icon from './Icon.astro';

interface Props {
  title?: string;
  text?: string;
  /** Product or page name, used in the pre-filled WhatsApp message. */
  context?: string | undefined;
  /** RFQ query string, e.g. "?type=torsion". */
  rfqQuery?: string;
  id?: string;
}

const {
  title = 'Send your drawing or sample. Get a quote within 24 hours.',
  text = `Tell us the spring type, quantity and what it has to do. Our usual minimum order is ${site.terms.moq}; smaller development runs are charged.`,
  context,
  rfqQuery = '',
  id = 'cta',
} = Astro.props;
---

<section class="cta bp-grid-dark section-y" data-surface="dark" aria-labelledby={`${id}-title`}>
  <div class="container-page cta-inner">
    <div class="max-w-[42rem]">
      <p class="eyebrow mb-3 text-blue-300">Request for quotation</p>
      <h2 id={`${id}-title`} class="text-h2 text-white">
        {title}
      </h2>
      <p class="mt-4 text-lead text-blue-300">{text}</p>
    </div>
    <div class="cta-actions">
      <Button
        href={quoteHref(rfqQuery, context)}
        variant="inverse"
        size="lg"
        iconRight="arrow-right"
      >
        Get a quote in 24 hours
      </Button>
      <Button
        href={whatsappHref(context)}
        variant="whatsapp"
        size="lg"
        icon="message-circle"
        data-event="whatsapp_click"
        rel="noopener"
        target="_blank"
      >
        WhatsApp us
      </Button>
      <a href={telHref()} class="cta-phone" data-event="call_click">
        <Icon name="phone" size={18} />
        <span class="tabular">{primaryPhone.display}</span>
      </a>
    </div>
  </div>
</section>

<style>
  .cta-inner {
    display: grid;
    gap: 32px;
    align-items: end;
  }

  .cta-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 16px;
  }

  .cta-phone {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    padding-inline: 4px;
    color: var(--color-white);
    font-family: var(--font-mono);
    font-weight: 500;
    text-decoration: underline;
    text-decoration-color: var(--color-blue-400);
    text-underline-offset: 0.25em;
  }

  .cta-phone:hover {
    color: var(--color-blue-300);
  }

  @media (min-width: 1024px) {
    .cta-inner {
      grid-template-columns: 1fr auto;
      gap: 48px;
    }

    .cta-actions {
      flex-direction: column;
      align-items: stretch;
      min-width: 300px;
    }

    .cta-phone {
      justify-content: center;
    }
  }
</style>
