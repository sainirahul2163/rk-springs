---
import { site, type DayName } from '@/data/site';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
const days: DayName[] = [
  'Monday',
  'Tuesday',
  'Wednesday',
  'Thursday',
  'Friday',
  'Saturday',
  'Sunday',
];
const to12 = (t: string) => {
  const [h = 0, m = 0] = t.split(':').map(Number);
  const suffix = h >= 12 ? 'PM' : 'AM';
  return `${((h + 11) % 12) + 1}:${String(m).padStart(2, '0')} ${suffix}`;
};
const open = `${to12(site.hours.opens)} – ${to12(site.hours.closes)}`;
---

<table class:list={['hours', className]}>
  <caption class="sr-only">Working hours</caption>
  <tbody>
    {days.map((d) => {
      const closed = site.hours.closedDays.includes(d);
      return (
        <tr class:list={[closed && 'is-closed']}>
          <th scope="row">{d}</th>
          <td>{closed ? 'Closed' : open}</td>
        </tr>
      );
    })}
  </tbody>
</table>

<style>
  .hours {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9375rem;
  }

  tr + tr {
    border-top: 1px solid var(--color-border);
  }

  th {
    text-align: left;
    font-weight: 400;
    color: var(--color-ink);
    padding: 8px 0;
  }

  td {
    text-align: right;
    font-family: var(--font-mono);
    color: var(--color-navy-900);
    padding: 8px 0;
  }

  .is-closed th,
  .is-closed td {
    font-weight: 600;
    color: var(--color-navy-900);
  }

  .is-closed td::before {
    content: '— ';
    color: var(--color-slate);
  }
</style>
