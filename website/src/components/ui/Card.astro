---
/**
 * Card variants: product (drawing + chips), industry (icon), article (type + meta), tool (icon).
 * The whole card is clickable through a stretched title link.
 */
import type { DiagramKey } from '@/data/navigation';
import { linkTo, type RouteId } from '@/data/routes';
import ProductDiagram from '../diagrams/ProductDiagram.astro';
import Icon, { type IconName } from './Icon.astro';
import SpecChips from './SpecChips.astro';

interface Props {
  variant: 'product' | 'industry' | 'article' | 'tool';
  title: string;
  description: string;
  to?: RouteId;
  href?: string;
  diagram?: DiagramKey;
  icon?: IconName;
  chips?: readonly string[];
  eyebrow?: string;
  meta?: string;
  cta?: string;
  headingLevel?: 'h2' | 'h3';
  class?: string;
}

const {
  variant,
  title,
  description,
  to,
  href: rawHref,
  diagram,
  icon,
  chips,
  eyebrow,
  meta,
  cta,
  headingLevel: H = 'h3',
  class: className,
} = Astro.props;

const href = rawHref ?? (to ? linkTo(to) : null);
const ctaText =
  cta ??
  {
    product: 'View specifications',
    industry: 'See springs for this industry',
    article: 'Read the guide',
    tool: 'Open the calculator',
  }[variant];
---

<article class:list={['card', `card-${variant}`, href && 'card-linked', className]}>
  {variant === 'product' && diagram && (
    <div class="card-figure bp-grid">
      <ProductDiagram name={diagram} decorative />
    </div>
  )}
  <div class="card-body">
    {(variant === 'industry' || variant === 'tool') && icon && (
      <span class="card-icon">
        <Icon name={icon} size={24} />
      </span>
    )}
    {eyebrow && <p class="eyebrow card-eyebrow">{eyebrow}</p>}
    <H class="card-title">
      {href ? (
        <a href={href} class="card-link">
          {title}
        </a>
      ) : (
        title
      )}
    </H>
    <p class="card-desc">{description}</p>
    {chips && chips.length > 0 && <SpecChips chips={chips} class="mt-4" />}
    {meta && <p class="card-meta">{meta}</p>}
    {href && (
      <p class="card-cta" aria-hidden="true">
        {ctaText}
        <Icon name="arrow-right" size={18} />
      </p>
    )}
  </div>
</article>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    background: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    overflow: hidden;
    transition: border-color 200ms var(--ease-out);
  }

  .card-linked:hover {
    border-color: var(--color-blue-700);
  }

  .card-linked:has(.card-link:focus-visible) {
    outline: 2px solid var(--color-action-600);
    outline-offset: 2px;
  }

  .card-link {
    color: inherit;
    text-decoration: none;
  }

  .card-link:focus-visible {
    outline: none;
  }

  .card-link::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .card-linked:hover .card-link {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }

  .card-figure {
    color: var(--color-navy-900);
    border-bottom: 1px solid var(--color-border);
    padding: 18px 22px 12px;
    background-color: var(--color-white);
  }

  .card-figure :global(svg) {
    max-height: 148px;
  }

  .card-body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 20px 22px 22px;
  }

  .card-icon {
    display: inline-grid;
    place-items: center;
    width: 44px;
    height: 44px;
    margin-bottom: 16px;
    color: var(--color-blue-700);
    background: var(--color-blue-50);
    border: 1px solid var(--color-grid);
    border-radius: var(--radius-control);
  }

  .card-eyebrow {
    color: var(--color-blue-700);
    margin-bottom: 8px;
  }

  .card-title {
    font-size: 1.1875rem;
    line-height: 1.3;
    color: var(--color-navy-900);
  }

  .card-desc {
    margin-top: 8px;
    color: var(--color-slate);
    font-size: 0.9688rem;
    line-height: 1.55;
  }

  .card-meta {
    margin-top: 14px;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--color-slate);
  }

  .card-cta {
    margin-top: auto;
    padding-top: 18px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-weight: 500;
    font-size: 0.9375rem;
    color: var(--color-blue-700);
  }

  .card-linked:hover .card-cta {
    color: var(--color-action-700);
  }
</style>
