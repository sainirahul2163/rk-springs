---
/**
 * Section band. The tones are the surfaces of the engineering sheet, darkest first:
 * `white` (the sheet itself) → `surface` → `tint`, plus `grid`/`dark` for a blueprint band and
 * `paper` for a drawing-paper panel, which flips the text, link and drawing colours.
 * The names are kept so every page that already passes a tone keeps working.
 */
interface Props {
  tone?: 'white' | 'surface' | 'tint' | 'dark' | 'grid' | 'paper';
  id?: string;
  labelledby?: string;
  class?: string;
  containerClass?: string;
  /** Remove the default vertical rhythm. */
  flush?: boolean;
}

const {
  tone = 'white',
  id,
  labelledby,
  class: className,
  containerClass,
  flush = false,
} = Astro.props;

const tones = {
  white: 'bg-void',
  surface: 'bg-sheet',
  tint: 'bg-panel',
  dark: 'bp-grid',
  grid: 'bp-grid',
  paper: 'bg-paper',
} as const;
---

<section
  id={id}
  aria-labelledby={labelledby}
  data-surface={tone === 'paper' ? 'paper' : undefined}
  class:list={[!flush && 'section-y', tones[tone], className]}
>
  <div class:list={['container-page', containerClass]}>
    <slot />
  </div>
</section>
