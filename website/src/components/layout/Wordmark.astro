---
/**
 * The site lockup: the real RK monogram plus the brand name.
 *
 * It wraps `Mark`, which the homepage uses, so the header, the footer and the homepage all
 * show one mark. The `tone` prop is kept for callers; both tones now resolve on the sheet,
 * since the whole site sits on it. `wm-glyph` stays on the monogram because the share-card
 * renderer (scripts/make-og.mjs) clones it.
 */
import Mark from './Mark.astro';

interface Props {
  tone?: 'light' | 'dark';
  class?: string;
}

const { tone = 'light', class: className } = Astro.props;
---

<Mark size={tone === 'dark' ? 'lg' : 'sm'} class={className} />
