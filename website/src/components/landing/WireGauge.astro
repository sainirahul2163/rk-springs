---
/**
 * Wire cross-sections at relative size above a 0–3 mm scale, with our wire range marked.
 * Built from site.capability, so it redraws if the range changes. For dark surfaces.
 */
import { fmt } from '@/components/diagrams/geometry';
import { site } from '@/data/site';

const { wireMinMm: min, wireMaxMm: max } = site.capability;

const x0 = 30;
const x1 = 570;
const scaleMm = 3;
const x = (mm: number) => x0 + ((x1 - x0) * mm) / scaleMm;

const base = 112;
const ruleY = 142;
const rOf = (mm: number) => mm * 14;

// Round sample sizes between the ends of the range, so the labels read like real wire sizes.
const inner = [0.8, 1.2, 1.6, 2.0].filter((d) => d > min + 0.2 && d < max - 0.2);
const wires = [min, ...inner, max];

const ticks = Array.from({ length: scaleMm * 10 + 1 }, (_, i) => i / 10);
const label = `Wire diameter range ${min.toFixed(2)} to ${max.toFixed(2)} mm, shown on a 0 to ${scaleMm} mm scale`;
---

<svg
  class="wg"
  viewBox="0 0 600 214"
  role="img"
  aria-label={label}
  xmlns="http://www.w3.org/2000/svg"
>
  <title>{label}</title>
  <rect
    class="wg-band"
    x={fmt(x(min))}
    y={ruleY - 9}
    width={fmt(x(max) - x(min))}
    height="18"
    rx="2"
  ></rect>
  <path class="wg-rule" d={`M${x0} ${ruleY}H${x1}`}></path>
  {ticks.map((t) => {
    const major = Math.abs(t - Math.round(t)) < 1e-6;
    const half = !major && Math.abs(t * 2 - Math.round(t * 2)) < 1e-6;
    const h = major ? 14 : half ? 9 : 5;
    return <path class="wg-tick" d={`M${fmt(x(t))} ${ruleY}V${ruleY + h}`} />;
  })}
  {[0, 1, 2, 3].map((t) => (
    <text class="wg-scale" x={fmt(x(t))} y={ruleY + 38} text-anchor="middle">
      {t === scaleMm ? `${t} mm` : t}
    </text>
  ))}

  {wires.map((d) => {
    const r = rOf(d);
    const cx = x(d);
    const cy = base - r;
    return (
      <g>
        <path class="wg-lead" d={`M${fmt(cx)} ${base + 4}V${ruleY - 11}`} />
        <circle class="wg-wire" cx={fmt(cx)} cy={fmt(cy)} r={fmt(r)} />
        <path
          class="wg-centre"
          d={`M${fmt(cx - r - 4)} ${fmt(cy)}H${fmt(cx + r + 4)}M${fmt(cx)} ${fmt(cy - r - 4)}V${fmt(cy + r + 4)}`}
        />
        <text class="wg-value" x={fmt(cx)} y={fmt(cy - r - 12)} text-anchor="middle">
          {d.toFixed(2)}
        </text>
      </g>
    );
  })}

  <text class="wg-range" x={fmt((x(min) + x(max)) / 2)} y="208" text-anchor="middle">
    OUR RANGE
  </text>
</svg>
