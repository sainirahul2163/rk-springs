---
/**
 * /landing hero: blueprint-dark sheet with the double torsion drawing, the main CTAs and a
 * datasheet-style row of key figures. All facts come from site.ts.
 */
import HeroDrawing from '@/components/diagrams/HeroDrawing.astro';
import Button from '@/components/ui/Button.astro';
import Icon from '@/components/ui/Icon.astro';
import { site } from '@/data/site';
import { quoteHref, whatsappHref } from '@/lib/contact';

const figures = [
  { k: 'Wire diameter', v: site.capability.wireRangeLabel },
  { k: 'Quotation', v: 'Within 24 h' },
  { k: 'Usual batch', v: site.terms.moq },
  { k: 'Established', v: `${site.foundingYear} · ${site.address.locality}` },
];
---

<section class="lp-hero" data-surface="dark" aria-labelledby="hero-title">
  <div class="lp-hero-bg bp-grid-dark" aria-hidden="true"></div>
  <div class="container-page lp-hero-inner">
    <div class="lp-hero-copy">
      <p class="lp-kicker">
        <span class="lp-kicker-tag">Springs &amp; wire forms</span>
        <span>
          {site.address.locality}, {site.address.city}
        </span>
        <span aria-hidden="true">·</span>
        <span>Since {site.foundingYear}</span>
      </p>
      <h1 id="hero-title">Precision spring manufacturer in Pune</h1>
      <p class="lp-hero-sub">
        Torsion and double torsion specialists. Springs and wire forms in{' '}
        <span class="lp-nowrap">{site.capability.wireRangeLabel}</span> wire, coiled and formed in{' '}
        {site.address.locality} to your drawing or sample.
      </p>
      <div class="lp-hero-ctas">
        <Button href={quoteHref()} variant="inverse" size="lg" iconRight="arrow-right">
          Get a quote in 24 hours
        </Button>
        <Button
          href={whatsappHref()}
          variant="whatsapp"
          size="lg"
          icon="message-circle"
          data-event="whatsapp_click"
          target="_blank"
          rel="noopener"
        >
          WhatsApp us
        </Button>
      </div>
      <a href={quoteHref('#drawing', 'a quote for my drawing')} class="lp-hero-upload">
        <Icon name="upload" size={18} />
        <span>
          Upload a drawing <span class="lp-hero-upload-k">PDF, DWG, DXF, STEP or photo</span>
        </span>
      </a>
    </div>

    <figure class="lp-sheet">
      <div class="lp-sheet-head" aria-hidden="true">
        <span>Fig. 1</span>
        <span>Double torsion spring</span>
        <span>NTS</span>
      </div>
      <div class="lp-sheet-art">
        <HeroDrawing />
      </div>
      <figcaption class="lp-sheet-cap">
        Our highest-volume parts: torsion and double torsion springs, made to drawing.
      </figcaption>
    </figure>
  </div>

  <div class="lp-figures">
    <dl class="container-page lp-figures-grid">
      {figures.map((f) => (
        <div class="lp-figure">
          <dt>{f.k}</dt>
          <dd class="tabular">{f.v}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>
