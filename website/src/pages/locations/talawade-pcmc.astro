---
import CompanyDetails from '@/components/ui/CompanyDetails.astro';
import ContactLinks from '@/components/ui/ContactLinks.astro';
import CTASection from '@/components/ui/CTASection.astro';
import FAQ from '@/components/ui/FAQ.astro';
import HoursTable from '@/components/ui/HoursTable.astro';
import LocationMap from '@/components/ui/LocationMap.astro';
import Section from '@/components/ui/Section.astro';
import SectionHeader from '@/components/ui/SectionHeader.astro';
import Todo from '@/components/ui/Todo.astro';
import { site } from '@/data/site';
import PageLayout from '@/layouts/PageLayout.astro';

const faqs = [
  {
    q: 'Where is the factory?',
    a: `Sr. No. 166, Sai Krupa Society, Sahyog Nagar, ${site.address.locality}, ${site.address.city} ${site.address.postalCode}. That is in the Pimpri-Chinchwad industrial belt.`,
  },
  {
    q: 'When are you open?',
    a: site.hours.summary,
  },
  {
    q: 'Do you supply only Pune?',
    a: 'No. We supply across India, ex-works Talawade. Transport is not included.',
  },
];
---

<PageLayout
  route="talawade"
  title="Spring Maker in Talawade"
  description="RK Springs & Wireforms, Sr. No. 166, Sai Krupa Society, Sahyog Nagar, Talawade, Pune 411062. Near Chikhali, Bhosari MIDC and Chakan. Thursday closed."
  context="a spring from Talawade"
  faqs={faqs}
>
  <Section tone="grid" labelledby="loc-h1">
    <SectionHeader
      as="h1"
      id="loc-h1"
      eyebrow="Location"
      title={`Spring manufacturer in ${site.address.locality}, PCMC`}
      lede={`${site.areaContext}. Wire ${site.capability.wireRangeLabel}, made to your drawing or sample.`}
    />
  </Section>

  <Section labelledby="where-title">
    <SectionHeader
      id="where-title"
      index={1}
      eyebrow="Address"
      title="The factory, not a trading desk"
    />
    <div class="prose mt-8 max-w-[46rem]">
      <p>
        {site.legalName} coils springs at Sr. No. 166, Sai Krupa Society, Sahyog Nagar,{' '}
        {site.address.locality}, {site.address.city} {site.address.postalCode}. The public name of
        the spring business is {site.brand}.
      </p>
      <p>
        Talawade sits in Pimpri-Chinchwad. Buyers in <strong>Chikhali</strong>,{' '}
        <strong>Bhosari MIDC</strong> and <strong>Chakan</strong> are a short run from the gate.
        Dispatch itself is ex-works: you collect, or you book the transporter.
      </p>
      <p>
        We supply across India. We do not export. There is no second plant and no city-swap page
        pretending we sit in Bhosari or Chakan.
      </p>
      <Todo text="landmarks and directions from the Talawade road; whether customer visits are welcome during working hours." />
    </div>
    <div class="loc-grid mt-10">
      <CompanyDetails />
      <div>
        <h2 class="text-h3 mb-2">Working hours</h2>
        <HoursTable />
        <ContactLinks class="mt-8" />
      </div>
    </div>
    <LocationMap class="mt-10" />
  </Section>

  <Section tone="surface" labelledby="area-title">
    <SectionHeader id="area-title" index={2} eyebrow="PCMC" title="Nearby industrial areas" />
    <div class="prose mt-8 max-w-[46rem]">
      <p>
        <strong>Chikhali</strong> and the Talawade residential-industrial mix sit next to the shop.{' '}
        <strong>Bhosari MIDC</strong> is the older engineering cluster to the south.{' '}
        <strong>Chakan</strong> is the vehicle and component belt to the north. If your stores are
        in any of those, a local pickup is straightforward.
      </p>
      <p>
        The Justdial listing “R K Spring Works, Bhosari” is not this company. Ours is RK
        Enterprises, Pune 411062.
      </p>
    </div>
  </Section>

  <Section labelledby="faq-title">
    <SectionHeader id="faq-title" index={3} eyebrow="Questions" title="Finding us" />
    <FAQ items={faqs} class="mt-8" />
  </Section>

  <CTASection context="a spring from Talawade" />
</PageLayout>

<style>
  .loc-grid {
    display: grid;
    gap: 40px;
  }

  @media (min-width: 900px) {
    .loc-grid {
      grid-template-columns: 1.2fr 1fr;
    }
  }
</style>
