---
import CompanyDetails from '@/components/ui/CompanyDetails.astro';
import FAQ from '@/components/ui/FAQ.astro';
import Section from '@/components/ui/Section.astro';
import SectionHeader from '@/components/ui/SectionHeader.astro';
import { RfqForm } from '@/components/rfq/RfqForm';
import { rfqFaqs } from '@/data/faqs';
import { site } from '@/data/site';
import { whatsappHref } from '@/lib/contact';
import PageLayout from '@/layouts/PageLayout.astro';

const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? '';
const wa = whatsappHref('a quote');
---

<PageLayout
  route="rfq"
  title="Request a quote"
  description="Drawing or sample in, quote within 24 hours. Torsion, extension, compression springs and wire forms from Talawade, Pune. Usual MOQ 5,000–10,000 pcs."
  context="a quote"
  hideActionBar
  faqs={rfqFaqs}
>
  <Section tone="grid" labelledby="rfq-h1">
    <SectionHeader
      as="h1"
      id="rfq-h1"
      eyebrow="Request for quotation"
      title="Send the drawing. Quote within 24 hours."
      lede={`Usual minimum order is ${site.terms.moq}. Smaller development runs are charged. WhatsApp is fine if you would rather not use the form.`}
    />
  </Section>

  <Section labelledby="form-title">
    <div class="rfq-layout">
      <div>
        <h2 id="form-title" class="text-h3 mb-6">
          Your enquiry
        </h2>
        <RfqForm
          client:idle
          sourcePage={Astro.url.pathname}
          turnstileSiteKey={turnstileSiteKey}
          whatsappHref={wa}
          search={Astro.url.search}
        />
      </div>
      <aside class="rfq-aside">
        <h2 class="text-h3 mb-4">Talk to the shop</h2>
        <CompanyDetails showTaxIds={false} />
        <p class="mt-6 text-small text-slate">
          Drawings stay with us. We use them only to quote and to make your parts.
        </p>
        <p class="mt-3">
          <a
            href={wa}
            class="text-blue-700 underline"
            data-event="whatsapp_click"
            target="_blank"
            rel="noopener"
          >
            WhatsApp a drawing instead
          </a>
        </p>
      </aside>
    </div>
  </Section>

  <Section tone="surface" labelledby="faq-title">
    <SectionHeader id="faq-title" index={1} eyebrow="Questions" title="Before you send" />
    <FAQ items={rfqFaqs} class="mt-8" />
  </Section>
</PageLayout>

<style>
  .rfq-layout {
    display: grid;
    gap: 40px;
  }

  .rfq-aside {
    padding: 24px;
    background: var(--color-blue-50);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    height: fit-content;
  }

  @media (min-width: 960px) {
    .rfq-layout {
      grid-template-columns: minmax(0, 1.4fr) minmax(16rem, 0.8fr);
      gap: 48px;
      align-items: start;
    }
  }
</style>
