---
import Todo from '@/components/ui/Todo.astro';
import { site } from '@/data/site';
import ArticleLayout from '@/layouts/ArticleLayout.astro';

const published = new Date('2026-10-04');
const faqs = [
  {
    q: 'What is a typical price per spring?',
    a: 'It depends on wire, material, quantity, tooling and finish. Send the drawing; we reply within 24 hours with a price for your part.',
  },
  {
    q: 'Why is a small order more per piece?',
    a: `Setup and the development sample are the same work whether you buy 500 or 8,000. Usual MOQ is ${site.terms.moq}. Below that, development charges apply.`,
  },
];
---

<ArticleLayout
  route="priceGuide"
  title="Spring Price Guide India"
  description="What decides the price of a custom spring in India: material, wire, quantity, tooling, finish and tolerances. Quote within 24 hours."
  h1="Spring price guide (India)"
  lede="A custom spring is priced from the drawing, not from a catalogue. These are the levers we use on every quote."
  published={published}
  context="a priced spring"
  takeaways={[
    'Material, wire size, quantity, tooling, finish and tolerances drive cost.',
    'Usual MOQ is 5,000–10,000 pcs. Smaller runs carry development charges.',
    'No published ₹ list. Send the drawing; quote within 24 hours.',
  ]}
  toc={[
    { id: 'levers', text: 'What drives cost' },
    { id: 'moq', text: 'Quantity and development' },
    { id: 'quote', text: 'How to get a price' },
    { id: 'questions', text: 'Questions' },
  ]}
  faqs={faqs}
  related={[
    {
      to: 'ordering',
      label: 'Ordering with us',
      description: 'MOQ, payment, ex-works, GST invoice.',
    },
    { to: 'hsnGst', label: 'HSN code and GST', description: 'The tax line on the invoice.' },
    { to: 'rfq', label: 'Request a quote', description: 'Drawing in, price in 24 hours.' },
  ]}
>
  <h2 id="levers">What drives cost</h2>
  <ul>
    <li>
      <strong>Material.</strong> Hard-drawn spring steel is the everyday wire. Music wire, stainless
      302 / 304 / 316 and oil-tempered cost more to buy and sometimes more to coil.
    </li>
    <li>
      <strong>Wire size and shape.</strong> Fine wire is slower. A double torsion spring with a
      centre loop is more work than a plain compression coil. Tight spring index (C below 4) is
      harder.
    </li>
    <li>
      <strong>Quantity.</strong> Setup is paid once. A long run spreads it. Usual minimum{' '}
      {site.terms.moq}.
    </li>
    <li>
      <strong>Tooling and development.</strong> A new part needs a sample. That is charged when the
      run is small.
    </li>
    <li>
      <strong>Finish.</strong> Plating and other coatings go through partners and add a line.
    </li>
    <li>
      <strong>Tolerances.</strong> Tight lengths, loads or angles mean more care and more scrap
      risk. Say what is actually critical.
    </li>
  </ul>

  <h2 id="moq">Quantity and development</h2>
  <p>
    Usual minimum order is {site.terms.moq}. Smaller runs are possible; they carry development or
    setup charges. Payment is immediate or within 30 days. Delivery is ex-works Talawade — transport
    is extra.
  </p>

  <h2 id="quote">How to get a price</h2>
  <p>
    Send the drawing or the sample. We quote that part within 24 hours — material, quantity, tooling
    and finish included.
    <Todo text="optional public price bands, only if you want them published." />
  </p>
</ArticleLayout>
