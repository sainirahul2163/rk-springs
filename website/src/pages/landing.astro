---
/**
 * Design preview for client review. Not the live homepage.
 * noindex, excluded from the sitemap so it cannot compete with /.
 * Layout follows the usual industrial-supplier homepage: hero with key figures, product range,
 * capability, industries, process, RFQ checklist, factory details and FAQ. Zero client JS.
 */
import '@/styles/landing.css';
import LandingHero from '@/components/landing/LandingHero.astro';
import LandingProducts from '@/components/landing/LandingProducts.astro';
import WireGauge from '@/components/landing/WireGauge.astro';
import Breadcrumbs from '@/components/layout/Breadcrumbs.astro';
import Button from '@/components/ui/Button.astro';
import CompanyDetails from '@/components/ui/CompanyDetails.astro';
import FAQ from '@/components/ui/FAQ.astro';
import Icon, { type IconName } from '@/components/ui/Icon.astro';
import PhotoPlaceholder from '@/components/ui/PhotoPlaceholder.astro';
import Todo from '@/components/ui/Todo.astro';
import { homeFaqs } from '@/data/faqs';
import { linkTo } from '@/data/routes';
import { mapUrl, phones, site } from '@/data/site';
import { mailHref, quoteHref, telHref, whatsappHref } from '@/lib/contact';
import BaseLayout from '@/layouts/BaseLayout.astro';

const homeHref = linkTo('home') ?? '/';
const springsHref = linkTo('springs');
const capabilitiesHref = linkTo('capabilities');
const industriesHref = linkTo('industries');
const orderingHref = linkTo('ordering');
const talawadeHref = linkTo('talawade');
const aboutHref = linkTo('about');

const registrations = [
  ...(site.certifications.zed.certified ? ['ZED certified MSME'] : []),
  `Udyam ${site.udyam}`,
  `GSTIN ${site.gstin}`,
  'Supply across India',
];

const proofs: { icon: IconName; title: string; text: string }[] = [
  {
    icon: 'clock',
    title: 'Quote within 24 hours',
    text: 'Send a drawing, a photo with dimensions, or the old spring. You get a price and a lead time the next working day.',
  },
  {
    icon: 'gauge',
    title: 'Critical, tight-tolerance parts',
    text: 'Buyers come to us when the spring has to fit first time in a switch, an instrument or a small assembly — not for a catalogue part.',
  },
  {
    icon: 'ruler',
    title: 'Reverse engineering from a sample',
    text: 'Send the unused spring if you have it, and say where it lives. We measure it and quote.',
  },
  {
    icon: 'badge-check',
    title: `Since ${site.foundingYear}, ZED certified`,
    text: `RK Enterprises has coiled springs in ${site.address.locality} since ${site.foundingYear}. The unit is ZED certified.`,
  },
];

const inHouseIcons: IconName[] = ['wrench', 'thermometer', 'ruler'];

const industries = [
  {
    to: 'switchgear' as const,
    title: 'Electrical and switchgear',
    icon: 'zap' as const,
    text: 'MCB and switch mechanism springs — a regular job in our unit.',
  },
  {
    to: 'automotive' as const,
    title: 'Automotive',
    icon: 'car' as const,
    text: 'Springs and wire forms for vehicle assemblies, made to your drawing.',
  },
  {
    to: 'instrumentation' as const,
    title: 'Instrumentation',
    icon: 'gauge' as const,
    text: 'Light, precise springs for instruments and control gear.',
  },
  {
    to: 'furniture' as const,
    title: 'Furniture',
    icon: 'armchair' as const,
    text: 'Torsion and extension springs for seating and fold mechanisms.',
  },
];

const steps = [
  {
    title: 'Send drawing or sample',
    text: 'A drawing, a dimensioned photo, or the old spring, plus quantity and material if you know it.',
  },
  {
    title: 'Quote in 24 hours',
    text: 'Price, development charges if the run is below our usual minimum, and a lead time.',
  },
  {
    title: 'Development sample',
    text: 'For a new part we make samples so you can try them in the assembly.',
  },
  { title: 'Your approval', text: 'Production does not start until you approve the sample.' },
  {
    title: 'Production',
    text: 'Coiling and forming, stress relieving, and end grinding where the drawing asks for it.',
  },
  { title: 'Dispatch', text: `${site.terms.delivery}.` },
];

const [openSummary, closedSummary] = site.hours.summary.split(' · ');

const rfqChecklist = [
  { k: 'Drawing', v: 'PDF, DWG, DXF, STEP or IGES — or a photo with dimensions' },
  { k: 'No drawing?', v: 'Send the old spring as a sample. We measure it.' },
  { k: 'Quantity', v: `Usually ${site.terms.moq}. Smaller runs carry development charges.` },
  { k: 'Material', v: 'If you know it: spring steel, stainless, music wire or oil-tempered' },
  { k: 'Application', v: 'Where the spring sits and what it has to do' },
];
---

<BaseLayout
  title="Pune spring factory preview"
  description="Design preview. Torsion, double torsion, extension and compression springs coiled in Talawade, Pune. Quote within 24 hours."
  route="landing"
  pageKind="WebPage"
  noindex
  htmlClass="landing-root"
>
  <div class="lp">
    <div class="lp-note">
      <div class="container-page lp-note-inner">
        <p class="lp-note-k">Design preview</p>
        <p class="lp-note-v">
          A new homepage layout for review. The live homepage is unchanged —
          <a href={homeHref}>open the current home page</a>.
        </p>
        <Breadcrumbs route="landing" class="lp-note-bc" />
      </div>
    </div>

    <LandingHero />

    <div class="lp-regs">
      <ul class="container-page lp-regs-list" aria-label="Registrations">
        {registrations.map((r) => (
          <li>
            <Icon name="badge-check" size={16} />
            <span>{r}</span>
          </li>
        ))}
      </ul>
    </div>

    <section class="lp-sec" aria-labelledby="products-title">
      <div class="container-page">
        <header class="lp-head lp-head-split">
          <div>
            <p class="lp-eyebrow">
              <span>01</span> Product range
            </p>
            <h2 id="products-title">Springs and wire forms we make</h2>
          </div>
          <div class="lp-head-aside">
            <p>
              Six spring types and wire forms, all in{' '}
              <span class="lp-nowrap">{site.capability.wireRangeLabel}</span> wire. Every part is
              made to your drawing or sample — nothing is sold from stock.
            </p>
            {springsHref && (
              <a class="lp-arrow-link" href={springsHref}>
                All springs <Icon name="arrow-right" size={18} />
              </a>
            )}
          </div>
        </header>
        <LandingProducts />
      </div>
    </section>

    <section class="lp-sec lp-dark" data-surface="dark" aria-labelledby="why-title">
      <div class="lp-dark-bg bp-grid-dark" aria-hidden="true"></div>
      <div class="container-page">
        <header class="lp-head">
          <p class="lp-eyebrow">
            <span>02</span> Why buyers choose us
          </p>
          <h2 id="why-title">The reasons customers give us, not a slogan</h2>
        </header>
        <ol class="lp-proofs">
          {proofs.map((p) => (
            <li class="lp-proof">
              <span class="lp-proof-ico">
                <Icon name={p.icon} size={26} />
              </span>
              <h3>{p.title}</h3>
              <p>{p.text}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="lp-sec lp-surface" aria-labelledby="cap-title">
      <div class="container-page">
        <header class="lp-head lp-head-split">
          <div>
            <p class="lp-eyebrow">
              <span>03</span> Shop-floor capability
            </p>
            <h2 id="cap-title">Light and precision springs, end to end</h2>
          </div>
          <div class="lp-head-aside">
            <p>
              Coiling, forming, stress relieving and end grinding happen in our unit. Plating and
              finishing go through partners.
            </p>
            {capabilitiesHref && (
              <a class="lp-arrow-link" href={capabilitiesHref}>
                Capabilities in detail <Icon name="arrow-right" size={18} />
              </a>
            )}
          </div>
        </header>

        <div class="lp-cap">
          <div class="lp-gauge" data-surface="dark">
            <p class="lp-gauge-k">Wire diameter</p>
            <p class="lp-gauge-v tabular">{site.capability.wireRangeLabel}</p>
            <div class="lp-gauge-art">
              <WireGauge />
            </div>
            <p class="lp-gauge-note">
              Outer diameter and length follow your drawing. We do not make rolling-shutter,
              agriculture or heavy springs above {site.capability.wireMaxMm.toFixed(2)} mm wire.
            </p>
          </div>

          <div class="lp-cap-cols">
            <div class="lp-cap-col">
              <h3>In-house</h3>
              <ul class="lp-cap-list">
                {site.capability.inHouse.map((item, i) => (
                  <li>
                    <span class="lp-cap-ico">
                      <Icon name={inHouseIcons[i] ?? 'wrench'} size={20} />
                    </span>
                    {item}
                  </li>
                ))}
              </ul>
              <Todo text="machine list and name-plate photos." block />
            </div>
            <div class="lp-cap-col">
              <h3>Materials</h3>
              <ul class="lp-cap-list lp-cap-list-plain">
                {site.capability.materials.map((m) => (
                  <li>{m}</li>
                ))}
              </ul>
            </div>
            <div class="lp-cap-col">
              <h3>Through partners</h3>
              <ul class="lp-cap-list lp-cap-list-plain">
                {site.capability.viaPartners.map((m) => (
                  <li>{m}</li>
                ))}
              </ul>
            </div>
            <div class="lp-cap-col">
              <h3>Commercial</h3>
              <dl class="lp-terms">
                <div>
                  <dt>Usual minimum order</dt>
                  <dd class="tabular">{site.terms.moq}</dd>
                </div>
                <div>
                  <dt>Payment</dt>
                  <dd>{site.terms.payment}</dd>
                </div>
                <div>
                  <dt>Delivery</dt>
                  <dd>{site.terms.delivery}</dd>
                </div>
              </dl>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="lp-sec" aria-labelledby="ind-title">
      <div class="container-page lp-ind-wrap">
        <header class="lp-head lp-ind-head">
          <p class="lp-eyebrow">
            <span>04</span> Industries
          </p>
          <h2 id="ind-title">Where our springs go</h2>
          <p class="lp-lede">
            Switchgear, automotive, instrumentation and furniture assemblies, plus other light
            mechanisms that need a spring made to drawing.
          </p>
          {industriesHref && (
            <a class="lp-arrow-link" href={industriesHref}>
              All industries <Icon name="arrow-right" size={18} />
            </a>
          )}
        </header>
        <ul class="lp-inds">
          {industries.map((it) => {
            const href = linkTo(it.to);
            if (!href) return null;
            return (
              <li>
                <a class="lp-ind" href={href}>
                  <span class="lp-ind-ico">
                    <Icon name={it.icon} size={24} />
                  </span>
                  <span class="lp-ind-body">
                    <h3>{it.title}</h3>
                    <span>{it.text}</span>
                  </span>
                  <Icon name="arrow-right" size={22} class="lp-ind-go" />
                </a>
              </li>
            );
          })}
        </ul>
      </div>
    </section>

    <section class="lp-sec lp-process" aria-labelledby="how-title">
      <div class="lp-process-bg bp-grid bp-grid-fade" aria-hidden="true"></div>
      <div class="container-page">
        <header class="lp-head lp-head-split">
          <div>
            <p class="lp-eyebrow">
              <span>05</span> How an order runs
            </p>
            <h2 id="how-title">From drawing to dispatch</h2>
          </div>
          <div class="lp-head-aside">
            <p>Six steps. Production does not start until you approve the sample.</p>
            {orderingHref && (
              <a class="lp-arrow-link" href={orderingHref}>
                Ordering, MOQ and payment <Icon name="arrow-right" size={18} />
              </a>
            )}
          </div>
        </header>
        <ol class="lp-steps">
          {steps.map((s, i) => (
            <li class="lp-step">
              <span class="lp-step-n" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </span>
              <h3>{s.title}</h3>
              <p>{s.text}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="lp-sec lp-rfq-sec" aria-labelledby="rfq-title">
      <div class="container-page">
        <div class="lp-rfq">
          <div class="lp-rfq-main" data-surface="dark">
            <p class="lp-eyebrow">
              <span>06</span> Request for quotation
            </p>
            <h2 id="rfq-title">Send your drawing or sample. Get a quote within 24 hours.</h2>
            <dl class="lp-rfq-list">
              {rfqChecklist.map((c) => (
                <div>
                  <dt>
                    <Icon name="check" size={18} />
                    {c.k}
                  </dt>
                  <dd>{c.v}</dd>
                </div>
              ))}
            </dl>
            <div class="lp-rfq-ctas">
              <Button href={quoteHref()} variant="inverse" size="lg" iconRight="arrow-right">
                Open the quote form
              </Button>
              <Button
                href={whatsappHref('a quote')}
                variant="whatsapp"
                size="lg"
                icon="message-circle"
                data-event="whatsapp_click"
                target="_blank"
                rel="noopener"
              >
                Send on WhatsApp
              </Button>
            </div>
          </div>

          <div class="lp-rfq-side">
            <h3>Talk to the factory</h3>
            <ul class="lp-contact">
              {phones.map((p) => (
                <li>
                  <Icon name="phone" size={20} />
                  <a href={telHref(p.e164)} class="tabular" data-event="call_click">
                    {p.display}
                  </a>
                  {p.whatsapp && <span class="lp-contact-tag">WhatsApp</span>}
                </li>
              ))}
              {site.emails.map((e) => (
                <li>
                  <Icon name="mail" size={20} />
                  <a href={mailHref(e)} data-event="email_click">
                    {e}
                  </a>
                </li>
              ))}
            </ul>
            <Todo text="confirm the main phone number and the main email." block />
            <div class="lp-hours">
              <p class="lp-hours-k">
                <Icon name="clock" size={18} /> Working hours
              </p>
              <p>{openSummary}</p>
              {closedSummary && <p class="lp-hours-closed">{closedSummary}</p>}
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="lp-sec lp-surface" aria-labelledby="loc-title">
      <div class="container-page">
        <header class="lp-head lp-head-split">
          <div>
            <p class="lp-eyebrow">
              <span>07</span> The factory
            </p>
            <h2 id="loc-title">
              {site.address.locality}, {site.address.city}
            </h2>
          </div>
          <div class="lp-head-aside">
            <p>{site.areaContext}.</p>
          </div>
        </header>
        <div class="lp-loc">
          <PhotoPlaceholder
            ratio="4 / 3"
            caption="the shop floor with coiling machines running"
            class="lp-loc-photo"
          />
          <div class="lp-loc-card">
            <CompanyDetails />
            <div class="lp-loc-links">
              <a
                class="lp-arrow-link"
                href={mapUrl}
                target="_blank"
                rel="noopener"
                data-event="outbound_click"
              >
                <Icon name="map-pin" size={18} /> Get directions
              </a>
              {talawadeHref && (
                <a class="lp-arrow-link" href={talawadeHref}>
                  Talawade and PCMC <Icon name="arrow-right" size={18} />
                </a>
              )}
              {aboutHref && (
                <a class="lp-arrow-link" href={aboutHref}>
                  About us <Icon name="arrow-right" size={18} />
                </a>
              )}
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="lp-sec" aria-labelledby="faq-title">
      <div class="container-page lp-faq">
        <header class="lp-head lp-faq-head">
          <p class="lp-eyebrow">
            <span>08</span> Questions
          </p>
          <h2 id="faq-title">Frequently asked questions</h2>
          <p class="lp-lede">
            Anything else?{' '}
            <a class="link" href={whatsappHref()} target="_blank" rel="noopener">
              Ask on WhatsApp
            </a>
            .
          </p>
        </header>
        <FAQ items={homeFaqs} />
      </div>
    </section>
  </div>
</BaseLayout>
