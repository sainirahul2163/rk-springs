---
import CTASection from '@/components/ui/CTASection.astro';
import FAQ from '@/components/ui/FAQ.astro';
import RelatedLinks from '@/components/ui/RelatedLinks.astro';
import Section from '@/components/ui/Section.astro';
import SectionHeader from '@/components/ui/SectionHeader.astro';
import SpecTable from '@/components/ui/SpecTable.astro';
import Todo from '@/components/ui/Todo.astro';
import { site } from '@/data/site';
import PageLayout from '@/layouts/PageLayout.astro';

const rows = [
  { label: 'Minimum order', value: site.terms.moq, note: site.terms.moqNote },
  { label: 'Quotation', value: site.terms.quote },
  { label: 'Payment', value: site.terms.payment },
  { label: 'Delivery', value: site.terms.delivery },
  { label: 'Supply area', value: site.terms.supplyArea },
  { label: 'GST invoice', value: `Yes. GSTIN ${site.gstin}` },
];

const faqs = [
  {
    q: 'Can I order fewer than 5,000 pieces?',
    a: `Yes, as a development or setup-charged run. The usual production minimum is ${site.terms.moq}.`,
  },
  {
    q: 'When does the 24-hour quote clock start?',
    a: 'When we have a drawing, a dimensioned photo or the sample, plus a quantity. Thursday is a closed day.',
  },
  {
    q: 'Who books the transporter?',
    a: 'Dispatch is ex-works Talawade. Transport is not included.',
  },
  {
    q: 'Do you take payment after 30 days?',
    a: `${site.terms.payment}. We will confirm the term on the quotation.`,
  },
  {
    q: 'Do you export?',
    a: 'No. Supply is across India only.',
  },
];
---

<PageLayout
  route="ordering"
  title="MOQ, Payment and Delivery Terms"
  description="MOQ 5,000–10,000 pcs, quote within 24 hours, payment immediate or within 30 days, ex-works Talawade. GST invoice. No export."
  faqs={faqs}
>
  <Section tone="grid" labelledby="ord-h1">
    <SectionHeader
      as="h1"
      id="ord-h1"
      eyebrow="Commercial"
      title="Ordering with us"
      lede="The terms we actually work to. Nothing here is a special offer."
    />
  </Section>

  <Section labelledby="terms-title">
    <SectionHeader id="terms-title" index={1} eyebrow="Terms" title="What we quote against" />
    <SpecTable rows={rows} class="mt-8" />
    <div class="mt-4">
      <Todo text="public wording for payment, and who books transport (buyer’s transporter, or we book at cost)." />
    </div>
    <div class="mt-3">
      <Todo text="whether the 24-hour clock runs on Thursday, and when a sample-based enquiry starts the clock." />
    </div>
  </Section>

  <Section tone="surface" labelledby="how-title">
    <SectionHeader id="how-title" index={2} eyebrow="Steps" title="From enquiry to dispatch" />
    <div class="prose mt-8 max-w-[46rem]">
      <ol>
        <li>You send a drawing, a photo or the old spring, and a quantity.</li>
        <li>We quote within 24 hours, including any development charge.</li>
        <li>For a new part we make a development sample.</li>
        <li>You approve the sample.</li>
        <li>We produce the batch and dispatch it ex-works Talawade.</li>
      </ol>
    </div>
  </Section>

  <Section labelledby="faq-title">
    <SectionHeader id="faq-title" index={3} eyebrow="Questions" title="FAQ" />
    <FAQ items={faqs} class="mt-8" />
  </Section>

  <Section tone="surface">
    <RelatedLinks
      title="Related"
      links={[
        {
          to: 'rfq',
          label: 'Request a quote',
          description: 'Drawing or sample in, quote within 24 hours.',
        },
        {
          to: 'springs',
          label: 'Springs we make',
          description: 'The types we coil in 0.40–2.50 mm wire.',
        },
        {
          to: 'contact',
          label: 'Contact us',
          description: 'Phone, WhatsApp and the factory address.',
        },
      ]}
    />
  </Section>

  <CTASection />
</PageLayout>
