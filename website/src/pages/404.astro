---
import Button from '@/components/ui/Button.astro';
import RelatedLinks from '@/components/ui/RelatedLinks.astro';
import { linkTo } from '@/data/routes';
import { site } from '@/data/site';
import BaseLayout from '@/layouts/BaseLayout.astro';

const home = linkTo('home') ?? '/';
const springs = linkTo('springs');
const contact = linkTo('contact');
---

<BaseLayout
  title="Page not found"
  description={`That address is not a page on the ${site.brand} website. Try the springs list or contact us.`}
  noindex
>
  <section class="container-page section-y">
    <p class="eyebrow mb-3 text-blue-700">404</p>
    <h1 class="text-h1">This page is not here</h1>
    <p class="mt-4 max-w-[36rem] text-lead text-slate">
      The link may be old, or the page is not published yet. The springs we make and the factory
      address are a click away.
    </p>
    <div class="mt-8 flex flex-wrap gap-3">
      <Button href={home} iconRight="arrow-right">
        Back to home
      </Button>
      {springs && (
        <Button href={springs} variant="secondary">
          Springs we make
        </Button>
      )}
      {contact && (
        <Button href={contact} variant="ghost">
          Contact
        </Button>
      )}
    </div>
    <RelatedLinks
      class="mt-12 max-w-[46rem]"
      title="Popular pages"
      links={[
        { to: 'torsion', label: 'Torsion springs', description: 'Our highest-volume spring.' },
        {
          to: 'doubleTorsion',
          label: 'Double torsion springs',
          description: 'Two coils and a centre loop.',
        },
        { to: 'compression', label: 'Compression springs', description: 'Push springs.' },
        { to: 'extension', label: 'Tension / extension springs', description: 'Pull springs.' },
        { to: 'wireForms', label: 'Wire forms', description: 'Clips, hooks and pins.' },
        { to: 'tools', label: 'Spring calculators', description: 'Rate, stress and units.' },
        { to: 'resources', label: 'Spring design guides', description: 'Measure, compare, HSN.' },
        { to: 'rfq', label: 'Request a quote', description: 'Quote within 24 hours.' },
      ]}
    />
  </section>
</BaseLayout>
