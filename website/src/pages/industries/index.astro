---
import Card from '@/components/ui/Card.astro';
import CTASection from '@/components/ui/CTASection.astro';
import Section from '@/components/ui/Section.astro';
import SectionHeader from '@/components/ui/SectionHeader.astro';
import { site } from '@/data/site';
import PageLayout from '@/layouts/PageLayout.astro';

const industries = [
  {
    to: 'automotive' as const,
    title: 'Automotive',
    icon: 'car' as const,
    description:
      'Light detent, return and seat springs in vehicle assemblies. Not suspension coils.',
  },
  {
    to: 'switchgear' as const,
    title: 'Electrical and switchgear',
    icon: 'zap' as const,
    description: 'MCB and switch-mechanism springs. A regular job in our unit.',
  },
  {
    to: 'instrumentation' as const,
    title: 'Instrumentation',
    icon: 'gauge' as const,
    description: 'Light, precise springs for instruments and control gear.',
  },
  {
    to: 'furniture' as const,
    title: 'Furniture',
    icon: 'armchair' as const,
    description: 'Torsion and extension springs for seating and fold mechanisms.',
  },
];
---

<PageLayout
  route="industries"
  title="Springs by Industry"
  description="Automotive, switchgear, instrumentation and furniture springs, wire Ø 0.40–2.50 mm, made to drawing or sample in Talawade, Pune."
  context="springs for your industry"
  pageKind="CollectionPage"
>
  <Section tone="grid" labelledby="ind-h1">
    <SectionHeader
      as="h1"
      id="ind-h1"
      eyebrow="Industries"
      title="Springs for your industry"
      lede={`Automobile, electrical and switchgear, instrumentation and furniture, plus other light assemblies. Wire ${site.capability.wireRangeLabel}. Made to your drawing or sample.`}
    />
  </Section>

  <Section labelledby="grid-title">
    <SectionHeader id="grid-title" index={1} eyebrow="Sectors" title="Four industries we serve" />
    <ul class="mt-10 grid gap-5 sm:grid-cols-2">
      {industries.map((it) => (
        <li>
          <Card
            variant="industry"
            title={it.title}
            description={it.description}
            to={it.to}
            icon={it.icon}
            headingLevel="h3"
          />
        </li>
      ))}
    </ul>
  </Section>

  <Section tone="surface" labelledby="choose-title">
    <SectionHeader
      id="choose-title"
      index={2}
      eyebrow="How to choose"
      title="Send the assembly, not just the type"
    />
    <div class="prose mt-8 max-w-[46rem]">
      <p>
        The industry label helps us guess the environment — oil, indoor switchgear, a damp
        instrument housing — but the drawing still decides the spring. If you are not sure which
        type you have, send a photo of the assembly and we will say.
      </p>
      <p>
        Wire {site.capability.wireRangeLabel}. Rolling-shutter, agriculture and heavier springs sit
        outside this range. See <a href="/springs/">the springs we coil</a>,{' '}
        <a href="/capabilities/">how we make them</a>, and{' '}
        <a href="/request-a-quote/">request a quote</a>.
      </p>
    </div>
  </Section>

  <CTASection context="springs for your industry" />
</PageLayout>
