---
import Card from '@/components/ui/Card.astro';
import CTASection from '@/components/ui/CTASection.astro';
import FAQ from '@/components/ui/FAQ.astro';
import Section from '@/components/ui/Section.astro';
import SectionHeader from '@/components/ui/SectionHeader.astro';
import { toolsFaqs } from '@/data/faqs';
import PageLayout from '@/layouts/PageLayout.astro';

const tools = [
  {
    to: 'compressionCalc' as const,
    title: 'Compression spring calculator',
    description: 'Rate, Wahl stress and solid height from wire, OD, coils and free length.',
  },
  {
    to: 'extensionCalc' as const,
    title: 'Extension spring calculator',
    description: 'Rate and body stress from wire, OD, body coils and initial tension.',
  },
  {
    to: 'rateConverter' as const,
    title: 'Spring rate converter',
    description: 'N/mm, kgf/mm and lbf/in, plus force, length and torque-per-degree.',
  },
];
---

<PageLayout
  route="tools"
  title="Free Spring Calculators (Metric)"
  description="Metric compression and extension spring calculators, plus a spring-rate unit converter. Estimates, then a quote from Talawade, Pune."
  context="a spring from the calculator"
  pageKind="CollectionPage"
  faqs={toolsFaqs}
>
  <Section tone="grid" labelledby="tools-h1">
    <SectionHeader
      as="h1"
      id="tools-h1"
      eyebrow="Engineering tools"
      title="Spring calculators"
      lede="First-pass rate and stress from your dimensions. Send the drawing afterwards and we confirm the design before production."
    />
  </Section>

  <Section labelledby="list-title">
    <SectionHeader id="list-title" index={1} eyebrow="Tools" title="Three calculators" />
    <ul class="mt-10 grid gap-5 lg:grid-cols-3">
      {tools.map((it) => (
        <li>
          <Card
            variant="tool"
            title={it.title}
            description={it.description}
            to={it.to}
            icon="calculator"
            headingLevel="h3"
          />
        </li>
      ))}
    </ul>
  </Section>

  <Section tone="surface" labelledby="use-title">
    <SectionHeader
      id="use-title"
      index={2}
      eyebrow="How to use them"
      title="Estimate, then send the drawing"
    />
    <div class="prose mt-8 max-w-[46rem]">
      <p>
        Enter millimetres and newtons. The result is an{' '}
        <strong>indicative engineering estimate</strong> from standard formulae. Material constants
        are typical published G and E values.
      </p>
      <p>
        Copy the link to keep the inputs. Use <strong>Get this spring made</strong> to pre-fill the
        quote form with wire, OD and type. Usual minimum order is 5,000–10,000 pcs. We reply within
        24 hours.
      </p>
    </div>
  </Section>

  <Section labelledby="faq-title">
    <SectionHeader id="faq-title" index={3} eyebrow="Questions" title="FAQ" />
    <FAQ items={toolsFaqs} class="mt-8" />
  </Section>

  <CTASection context="a spring from the calculator" />
</PageLayout>
