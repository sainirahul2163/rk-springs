{
  "name": "rk-springs-website",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/audit-html.ts",
    "preview": "astro preview",
    "audit": "node scripts/audit-html.ts",
    "check": "astro check && eslint . && prettier --check .",
    "lint": "eslint .",
    "format": "prettier --write .",
    "todo": "node scripts/list-todos.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lh": "node scripts/lighthouse.mjs",
    "js-budget": "node scripts/js-budget.mjs"
  },
  "dependencies": {
    "@astrojs/react": "7.0.0",
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/vercel": "11.0.11",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@lucide/astro": "1.52.0",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "schema-dts": "^2.1.0",
    "tailwindcss": "4.3.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@eslint/js": "9.39.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-plugin-astro": "1.7.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "globals": "17.13.0",
    "prettier": "3.9.9",
    "@playwright/test": "^1.56.1",
    "lighthouse": "^12.8.2",
    "chrome-launcher": "^1.2.1",
    "prettier-plugin-astro": "1.1.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "^5.0.3"
  }
}
