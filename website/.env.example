# Copy to .env and fill in. Never commit .env.
# Variables prefixed PUBLIC_ are exposed to the browser. Everything else is server-only.

# Canonical origin, no trailing slash (e.g. https://www.rksprings.in).
# Leave empty locally. Required on Vercel production — the build fails if it is missing.
# Preview and local builds stay noindex.
PUBLIC_SITE_URL=

# Set to "true" on a client-review preview build to show TODO(client) markers and photo placeholders.
PUBLIC_SHOW_TODOS=

# --- RFQ backend (Phase 4) ---
# Leave blank to use the local fallback: submissions are written to .rfq-dev/
# and printed in the server log. Apply supabase/migrations/001_rfqs.sql before
# pointing a live site at Supabase.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
RFQ_FROM_EMAIL=
RFQ_NOTIFY_EMAIL=
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Analytics (optional; scripts load only when set) ---
PUBLIC_GA4_ID=
PUBLIC_CLARITY_ID=
