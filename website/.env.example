# Copy to .env and fill in. Never commit .env.
# Variables prefixed PUBLIC_ are exposed to the browser. Everything else is server-only.

# Canonical origin override, no trailing slash. Leave EMPTY on Vercel: the final domain
# https://www.rksprings.com (src/data/site.ts) is used for canonicals, sitemap and JSON-LD.
# Vercel production is indexable; preview and development deployments stay noindex.
# Locally, set PUBLIC_SITE_URL=https://www.rksprings.com to rehearse an indexable production build.
PUBLIC_SITE_URL=

# Set to "true" on a client-review preview build to show TODO(client) markers and photo placeholders.
PUBLIC_SHOW_TODOS=

# --- RFQ backend (Phase 4) ---
# Leave blank to use the local fallback: submissions are written to .rfq-dev/
# and printed in the server log. Apply supabase/migrations/001_rfqs.sql before
# pointing a live site at Supabase.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
RFQ_FROM_EMAIL=
RFQ_NOTIFY_EMAIL=
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Analytics (optional; scripts load only when set) ---
PUBLIC_GA4_ID=
PUBLIC_CLARITY_ID=

# --- Search engine verification (optional; meta tag renders only when set) ---
# Prefer a DNS TXT record (Search Console "Domain" property). Use these only for a URL-prefix
# property: paste the content="..." value from Google Search Console / Bing Webmaster Tools.
PUBLIC_GOOGLE_SITE_VERIFICATION=
PUBLIC_BING_SITE_VERIFICATION=
